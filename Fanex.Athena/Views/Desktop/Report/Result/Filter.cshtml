@using Fanex.Athena.Model.Report.Constants
@model Fanex.Athena.Model.Report.ViewModel.Result.ResultReportViewModel

<div class="page-form">
    @using (Html.BeginForm("Result", "Report", FormMethod.Post, new { @id = "ResultPage" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col l2 m2 s12 input-field calendar single-date" id="singleDate">
                @DesktopRazorHelper.SingleDatePicker(Model.Param.FromDate, Model.Param.BalanceUpDay.Value, DateTime.Today, "Date")
            </div>

            <div class="input-field input col l3 m3 s12 calendar date-range" id="dateRange" style="display: none;">
                @DesktopRazorHelper.DateRangePicker(Model.Param.FromDate, Model.Param.ToDate, Model.Param.BalanceUpDay.Value, DateTime.Today)
            </div>

            <div class="col l2 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>

            <div class="col l2 m3 s12 input-field date-submit">
                <a href="javascript:;" class="center-align label label-default" id="submitToday" data-date="@DateTime.Today.ToString("MM/dd/yyyy")">
                    @DateTime.Today.ToString("MM/dd/yyyy")
                </a>
                <a href="javascript:;" class="center-align label label-default" id="submitYesterday" data-date="@DateTime.Now.AddDays(-1).ToString("MM/dd/yyyy")">
                    @DateTime.Now.AddDays(-1).ToString("MM/dd/yyyy")
                </a>
            </div>

            <div class="col l3 m4 s12 input-field">
                <a href="javascript:;" class="center-align label label-primary active" id="submitNormal">@ViewResources.Normal</a>
                <a href="javascript:;" class="center-align label label-primary" id="submitOutright" data-isOutright="0">@ViewResources.Outright</a>
                @if (ViewBag.IsAllowedKeno)
                {
                    <a href="javascript:;" class="center-align label label-primary" id="submitKeno" data-vendorProductId="@ResultVendorProductTypes.Keno">
                        @ViewResources.ProductKN
                    </a>
                }
                @if (ViewBag.IsAllowedLottery)
                {
                    <a href="javascript:;" class="center-align label label-primary" id="submitLottery" data-vendorProductId="@ResultVendorProductTypes.Lottery">
                        @ViewResources.ProductLT
                    </a>
                }
                @if (ViewBag.IsAllowedVRG)
                {
                    <a href="javascript:;" class="center-align label label-primary" id="submitVirtualGame" data-vendorProductId="@ResultVendorProductTypes.VirtualGame">
                        @ViewResources.ProductVRG
                    </a>
                }
                @if (ViewBag.IsAllowedTG)
                {
                    <a href="javascript:;" class="center-align label label-primary" id="submiTableGame" data-vendorProductId="@ResultVendorProductTypes.TableGame">
                        @ViewResources.ProductTG
                    </a>
                }
            </div>
        </div>

        <div class="row">
            <div class="col l12 m12 s12">
                <ul class="list result-note">
                    <li>@string.Format(ViewResources.DateRangeNote, Model.Param.BalanceUpDay.Value.ToString("MM/dd/yyyy"))</li>
                    @if ((bool)ViewBag.IsAllowedRNG)
                    {
                        <li>@ViewResources.RngCasinoAndBingoExcludedNote</li>
                    }
                </ul>
            </div>
        </div>

        <div class="row" id="sportAndLeagueFilter" style="visibility: hidden;">
            <div class="col l3 m5 s12 input-field">
                <select class="select" id="ddlSport"></select>
                <label>@ViewResources.Sport</label>
            </div>
            <div class="col l6 m6 s12 input-field">
                <select class="select" id="ddlLeague">
                    <option value="0" selected="selected">*..::*@ViewResources.ShowAllLeagues*::..*</option>
                </select>
                <label>@ViewResources.League</label>
            </div>
        </div>

        <div class="icon-block">
            <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
        </div>
    }
</div>