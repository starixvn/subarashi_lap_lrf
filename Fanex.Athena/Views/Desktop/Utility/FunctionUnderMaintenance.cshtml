@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Fanex.Athena.Resources.ViewResources.UnderMaintenance</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/um.css")" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="img">
            <img src="@Url.ContentLink("/www/css/build/images/UM.png")" />
        </div>
        <div class="caption">
            <p>@ViewBag.Message</p>
        </div>
    </div>
    <script type="text/javascript">
        if (window.parent != window) {
            var sameOrigin;
            try {
                sameOrigin = window.parent.location.host == window.location.host;
            } catch (e) {
                sameOrigin = false;
            }
            sameOrigin && (window.parent.location = location.href);
        }
    </script>
</body>
</html>