<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">  
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />
  </system.web>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" xdt:Transform="Replace"/>
    </staticContent>
  </system.webServer>
</configuration>