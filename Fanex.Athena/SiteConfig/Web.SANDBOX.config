      </dependentAssembly>
    </assemblyBinding>
    <ThrowUnobservedTaskExceptions enabled="false" />
  </runtime>
  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="01:00" UMTo="23:00" SiteId="2000001" UMPageUrl="~/Utility/UnderMaintenance">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>