@using Newtonsoft.Json;
@using Fanex.Athena.Model.Customer.ViewModel.CommissionGroupList;
@model CommissionGroupListViewModel
@{
    Layout = null;
}
<div class="page-results">
    <div class="result-content">
        <div class="main-content">
            @if (Model.Groups.Count == 0)
            {
                <p class="no-info-row">@ViewResources.NoInfo</p>
            }
            else
            {
                <table id="comm-group-list" class="table table-bordered comm-group-list"></table>
                <script type="text/javascript">
                    var productListData = @Html.Raw(JsonConvert.SerializeObject(Model.ProductList));
                </script>
                <input type="hidden" id="CommGroupsData" value="@JsonConvert.SerializeObject(Model.Groups)" />
            }
        </div>
    </div>
</div>