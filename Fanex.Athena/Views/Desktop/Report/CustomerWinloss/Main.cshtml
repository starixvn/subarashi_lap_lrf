@{
    ViewBag.Title = "LAP - " + ViewResources.Report + " - " + ViewResources.CustomerWinLoss;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@model Fanex.Athena.Model.Report.ViewModel.CustomerWinLossViewModel
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/reports/customerwinloss.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/reports/customerwinloss.chunk.js")"></script>
}

@section Header
{
    @if(!Model.IgnoreSharding){
        Html.RenderPartial("~/Views/Desktop/Report/CustomerWinloss/Tab.cshtml");
    }
}

@section Filter
{
    @{ Html.RenderPartial("~/Views/Desktop/Report/CustomerWinloss/Filter.cshtml"); }
}

@section Content
{
    @{Html.RenderPartial("~/Views/Desktop/Report/CustomerWinloss/Content.cshtml");}
}