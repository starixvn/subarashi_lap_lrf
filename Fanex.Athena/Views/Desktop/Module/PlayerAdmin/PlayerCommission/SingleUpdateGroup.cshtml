@using System.Linq;
@using Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerCommission;
@using Fanex.Athena.Controllers.Customer.Helpers;
@model SingleMoveGroupViewModel
@{
    ViewBag.Title = "LAP - " + ViewResources.UpdateCommissionValue;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
    var currentComms = Model.CurrentGroup.CommValues ?? Model.Groups.FirstOrDefault().CommValues;
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/playercommission/index.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/playercommission/singleupdategroup.chunk.js")"></script>
}
@section Content
{
    @Html.Hidden("CustIds", Model.CustId)
    @Html.Hidden("Products", string.Join(",", Model.ProductPermissions.Select(p => p.Key)))
    <div class="div-content">
        <div class="row">
            <div class="col l6 m12 s18">
                <div class="div-result error-message">@ViewResources.UpdateCommGroup_Warning</div>
            </div>
        </div>
        <div class="row">
            <div class="col l6 m12 s18">
                <table id="tbl-comm" class="table tbl-comm elm-update-comm">
                    <thead class="">
                        <tr>
                            <th> @ViewResources.Product</th>
                            <th class="col-comm"> @ViewResources.Commission (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.ProductPermissions)
                        {
                            var comm = currentComms[p.Key];
                            if (!p.Value)
                            {
                                continue;
                            }
                            <tr>
                                <td>@ViewResources.ResourceManager.GetString("Product" + p.Key)</td>
                                <td class="text-center">
                                    @Html.Hidden("comm0-" + p.Key, comm)
                                    @Html.Hidden("comm4-" + p.Key, comm)
                                    <div class="col l4 m4 s4 input-field first-value">
                                        @DesktopGroupCommRazorHelper.CommDropDownFirst("comm1-" + p.Key, CustomerComGroupHelper.GetCommPart(comm, 1))
                                    </div>
                                    <div class="col l4 m4 s4 input-field">
                                        @DesktopGroupCommRazorHelper.CommDropDownSecond("comm2-" + p.Key, CustomerComGroupHelper.GetCommPart(comm, 2))
                                    </div>
                                    <div class="col l4 m4 s4 input-field third-value">
                                        @DesktopGroupCommRazorHelper.CommDropDownThird("comm3-" + p.Key, CustomerComGroupHelper.GetCommPart(comm, 3))
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="input-field col l6 m12 s18">
                <div class="btn-group">
                    <button type="button" disabled="disabled" class="btn btn-submit">@ViewResources.Save</button>
                    <button type="button" class="btn btn-cancel">@ViewResources.Cancel</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col l6 m12 s18">
                <div id="div-result" class="div-result hide">
                </div>
            </div>
        </div>
    </div>
}
