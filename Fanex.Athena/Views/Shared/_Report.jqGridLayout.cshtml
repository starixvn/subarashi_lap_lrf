@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Extension.Helper;
﻿@using Fanex.Athena.Service.Core.Users.Interfaces;
@using Fanex.Athena.Model.Auth.Enum;
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/jqGridLayoutStyles")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/jqGridLayoutScripts")
    @RenderSection("pagejs", required: false)
}
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var userSession = sessionService.UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == AppMode.Self;
}
<div class="container_26">
    <div class="grid_26 @(isAppModeSelf ? string.Empty: "hide")">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter", required: false)
</div>
<div class="content-main">
    <div class="loading"></div>
    <div class="block-body"></div>
    @RenderBody()
</div>

<div class="page-portal">
    <div class="toast-container toast-container-top toast-container-right">
        <div class="toast-align">
        </div>
    </div>
</div>