  "jest": {
    "testMatch": [
      "<rootDir>/www/**/__tests__/**/*.test.js?(x)",
      "<rootDir>/www/**/?(*.)(spec|test).js?(x)"
    ],
    "collectCoverageFrom": [
      "www/js/source/reactpages/**/*.{js,jsx}",
      "!www/js/source/reactpages/**/index.{js,jsx}"
    ],
    "moduleNameMapper": {
      "@jsroot(.*)$": "<rootDir>/www/js/source/reactpages/$1"
    },
    "setupFilesAfterEnv": [
      "raf/polyfill"
    ],
    "setupFiles": [
      "./www/js/source/reactpages/setupTests.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  }
