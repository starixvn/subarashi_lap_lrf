@using Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerBatchUpdate;
@model BasePlayerBatchUpdateViewModel
@{
    ViewBag.Title = "LAP - " + ViewResources.UpdateAccountStatus;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/playerBatchUpdate/index.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/playerBatchUpdate/accountStatus.chunk.js")"></script>
}
@section Filter
{
    <div class="row page-form">
        <form class="player-account-status-edit" id="player-account-status-edit"
              action""
              method="post">
            <div class="row">
                <div class="input-field col l3 m6 s6">
                    <label>@ViewResources.SelectedCustomers</label>
                </div>
                <div class="input-field col l3 m6 s6">
                    <label>@ViewResources.UpdateToAccountStatus</label>
                </div>
            </div>
            <div class="row">
                <div class="input-field col l3 m6 s6">
                    <div class="multiselect-container">
                        <select id="ddl-customers"></select>
                    </div>
                </div>
                <div class="input-field col l3 m6 s6">
                    <select id="ddl-status" class="select">
                        <option value="-1" disabled="disabled" selected>@ViewResources.PleaseSelectOne</option>
                        <option value="0">@ViewResources.Active</option>
                        <option value="1">@ViewResources.Locked</option>
                        <option value="2">@ViewResources.Closed</option>
                    </select>
                </div>
            </div>
            @Html.Hidden("CustNames", Model.CustNamesStr)
            @Html.Hidden("CustIds", Model.CustIdsStr)
        </form>
    </div>
}
@section Content
{
    <div class="div-content">
        <div class="row msg-confirm hide">
            <div class="input-field col l6 m12 s12">
                @ViewResources.ConfirmBatchUpdateAccountStatus
            </div>
        </div>
        <div class="row msg-confirm hide">
            <div class="input-field col l6 m12 s12">
                <div class="warning-msg">
                    @ViewResources.MessageBatchUpdateAccountStatus_Lock
                </div>
            </div>
        </div>
        <div class="row msg-confirm hide">
            <div class="input-field col l6 m12 s12">
                <div class="warning-msg">
                    @ViewResources.MessageBatchUpdateAccountStatus_Close
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col l6 m12 s12">
                <div id="div-result" class="div-result hide">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="input-field col l6 m12 s12">
                <div class="btn-group">
                    <button type="button" disabled="disabled" class="btn btn-submit">@ViewResources.Save</button>
                    <button type="button" class="btn btn-cancel">@ViewResources.Cancel</button>
                </div>
            </div>
        </div>
    </div>
}
