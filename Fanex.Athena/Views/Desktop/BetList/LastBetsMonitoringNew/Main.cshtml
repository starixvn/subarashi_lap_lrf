@{
    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LAP", HttpUtility.HtmlDecode("&bull;"), ViewResources.Report, ViewResources.LastBetsMonitoring);
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@{
    var appSettings = DependencyResolver.Current.GetService<IAppSettings>();
    var betTicketEventBuilderUrl = appSettings.BetTicketEventBuilderUrl;
}
@section css {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/lastbetmonitoring.css")" rel="stylesheet" />
}
@section js {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/lib/jqgrid.chunk.js")"></script>
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/betlist/lastbetmonitoring.chunk.js")"></script>
    <script async src="@betTicketEventBuilderUrl" id="event-builder-script"></script>
    <script async src="@Url.Action("token", "home")"></script>
}

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-child medium" data-name="Platform"></td>
        <td class="col-child" data-name="ExternalId"></td>
        <td class="col-child" data-name="SystemId"></td>
        <td class="col-child" data-name="CustomerClass"></td>
        <td class="col-medium" data-name="TransTime"></td>
        <td class="col-large medium" data-name="Choice"></td>
        <td class="col-small" data-name="Odds"></td>
        <td class="col-child medium" data-name="Stake"></td>
        <td class="col-child medium" data-name="Status"></td>
    </tr>
}

@*----- Filter -----*@
<div class="page-form">
    @{
        Html.RenderPartial("~/Views/Desktop/BetList/LastBetsMonitoringNew/Filter.cshtml");
    }
</div>

@*----- Content -----*@
<div class="page-results">
    <div class="result-content">
        <div class="main-content">
            <div id="betlist_content" class="betlist-container">
                <table id="last-bets-monitoring" class="table">
                    <thead>
                        @RenderFirstRow()
                        <tr id="monitor-header" class="report-table-header">
                            <th data-name="Platform">
                                @ViewResources.Platform
                            </th>
                            <th data-name="ExternalId">
                                @ViewResources.ExternalId
                            </th>
                            <th data-name="SystemId">
                                @ViewResources.SystemId
                            </th>
                            <th data-name="CustomerClass">
                                @ViewResources.CustomerClass
                                &nbsp;&nbsp;<span class="icon-info"></span>
                            </th>
                            <th data-name="TransTime">
                                @ViewResources.TransTime
                            </th>
                            <th class="bl-choice" data-name="Choice">
                                @ViewResources.Choice
                            </th>
                            <th data-name="Odds">
                                @ViewResources.Odds
                            </th>
                            <th data-name="Stake">
                                @ViewResources.Stake
                            </th>
                            <th data-name="Status">
                                @ViewResources.Status
                            </th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>

            <input type="hidden" id="BetListMetaModel" value="@Model.Param.ToJson()" />
        </div>
    </div>
</div>