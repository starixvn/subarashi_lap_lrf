@using System.Linq;
@using System.Web.Optimization;
@using Fanex.Athena.Service.Core.Users.Interfaces;
@using Fanex.Athena.Model.Auth.Enum;
@using Fanex.Athena.Service.StatelessCore.Interfaces;

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var appSettings = DependencyResolver.Current.GetService<IAppSettings>();
    var licenseeSettingService = DependencyResolver.Current.GetService<ILicenseeSettingService>();

    var userSession = sessionService.UserSession;
    var licSession = sessionService.LicenseeSession;
    var userCurrencies = userSession == null || userSession.CurrencyList == null ?
        new Dictionary<string, string>() :
        userSession.CurrencyList.ToDictionary(x => x.Key.ToString(), x => x.Value);
    var isParasiticMode = userSession != null && userSession.ApplicationMode == AppMode.Parasitic;
    var isFakeLicensee = licenseeSettingService.IsFakeLicensee(licSession.LicenseeName);
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    @RenderSection("css", required: false)
    <link href="@Url.ContentLink("/Content/Plugin/Note/note.css")" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/CoreJs")
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        Site.resolveClientUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
        Site.userCurrencies = @(Html.Raw(JsonHelper.ToJson(userCurrencies)));
        var _page = {
            lang: '@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag'
        };
    </script>
    @RenderSection("js", required: false)
</head>
<body class="@ViewBag.MasterClass">
    @{
        var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
    }
    <input type="hidden" id="UserCurrencies" value="" />
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( appSettings.HistoryDate)" />
    <input type="hidden" id="IsFakeLicensee" value="@( isFakeLicensee ? 1 : 0)" />
    @Html.AntiForgeryToken()
    <div id="BodyContent">
        @RenderBody()
    </div>
    <script type="text/javascript">
        $(window).load(function () {
            if (navigator.userAgent.toLowerCase().indexOf('safari') > 0 && navigator.appVersion.indexOf("Mac") != -1) {
                $('#BodyContent').css('overflow-y', 'auto');
                $('#BodyContent').css('max-height', 500);
            };
        });
    </script>
    @if (isParasiticMode)
    {
        Html.RenderPartial("~/Views/Shared/_SessionScript.cshtml");
    }
    @if (appSettings.Environment.Equals("PRO", StringComparison.OrdinalIgnoreCase))
    {
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'UA-93927620-1');

            window.logOpenBetlistEvent = function () {
                try {
                    window.gtag('event', 'view_bet_list', {
                        'event_label': 'Bet List Promotion',
                        'event_category': 'bet_list',
                        'non_interaction': true
                    });
                }
                catch (err) {
                }
            };
        </script>
    }
</body>
</html>