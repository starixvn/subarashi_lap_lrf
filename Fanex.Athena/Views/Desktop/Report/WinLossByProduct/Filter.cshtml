@model Fanex.Athena.Model.Report.ViewModel.WinLossByProductViewModel
@{
    var appSettings = new AppSettings();
}

<div class="page-form">
    <form id="SearchForm" name="SearchForm" method="post" action="">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="input-field input col l3 m4 s12 calendar date-range">
                @DesktopRazorHelper.DateRangePicker(Model.Param.FromDate, Model.Param.ToDate, appSettings.HistoryDate, appSettings.MaxDate)
            </div>

            <div class="input-field col l2 m2 s12">
                @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId, true, true)
                <label>@ViewResources.Currency</label>
            </div>

            @DesktopRazorHelper.RenderProductFilter(Model.Param.ProductOptions, 3, 3)

            <div class="input-field col l3 m3 s12">
                @Html.TextBox("Username", Model.Param.Username, new { placeholder = (Model.IsFakeLicensee ? ViewResources.ExternalId : ViewResources.ExternalIdOrSystemId), autocomplete = "off" })
                <label>@ViewResources.Username</label>
                <ul id="suggestionDropdown" class="dropdown-content ac-dropdown"></ul>
            </div>

            <div class="col right icon-block">
                @if (!Model.IsFakeLicensee)
                {
                    <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                }
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>

        <div class="row">
            <div class="input-field input col l3 m4 s12">
                @DesktopRazorHelper.DrawFilter(Model.Param.DrawFilter)
            </div>

            <div class="input-field input col l2 m2 s12">
                @DesktopRazorHelper.ReportBy(Model.Param.ReportBy)
            </div>

            <div class="input-field input col l3 m3 s12">
                @DesktopRazorHelper.ExcludeTestData(Model.Param.IsExcludedTestData)
            </div>

            <div class="col l3 m3 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>
        </div>
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>

    @Html.Hidden("ProductOptionJson", Model.Param.ProductOptions.ToJson())
    @Html.Hidden("drillDownLicenseeId", Model.Param.LicenseeId)
    @Html.Hidden("IsAllowedBACommission", Model.ProductAccess.IsAllowBA)
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
    @Html.Hidden("HasAmountDueToColumn", Model.HasAmountDueToColumn)
</div>