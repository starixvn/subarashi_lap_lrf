@helper ReportTitleLicenseeWLProductCodeList(IEnumerable<ProductOption> productOptions)
{
    /**/

    var productCodeList = string.Empty;
    foreach (var product in productOptions)
    {
        if (product.Status)
        {
            productCodeList += product.Code + ", ";
        }
    }
    productCodeList = string.IsNullOrEmpty(productCodeList) ? string.Empty : string.Format(", {0} ({1})", ViewResources.LicenseeW_L, productCodeList.TrimEnd(' ', ','));

    @productCodeList
}
