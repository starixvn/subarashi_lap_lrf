@model Fanex.Athena.Model.TotalBet.ViewModel.MoneyLineViewModel

@using (Html.BeginForm("Index", "MoneyLineTotalBet", FormMethod.Post, new { @id = "MoneyLineForm" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        @*// -----------------------------Currency-----------------------------------//*@
        <div class="col l2 m2 s12 input-field">
            @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select currencylist", Model.Param.CurrencyId)
            <label>@ViewResources.Currency</label>
        </div>

        @*// -----------------------------Base Currency-----------------------------------//*@
        <div class="col l2 m2 s12 input-field">
            @DesktopRazorHelper.BasedCurrency(Model.Param.BaseCurrency)
            <label>@ViewResources.BaseCurrency</label>
        </div>

        <div class="col l1 m2 s12 button-block">
            <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
        </div>

        @*// -----------------------------Refresh countdown------------------------ //*@
        <div class="col l1 m1 s12 button-block">
            @DesktopRazorHelper.TimerCountDown("moneyline", 60)
        </div>

        <div class="col right icon-block">
            <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
        </div>
    </div>
    if (Model.Param.HasMonitoringPermission)
    {
	    <div class="row">
		    <div class="col l1 m1 s2"><b>@ViewResources.Note:</b></div>
		    <div class="col l11 m11 s10">@ViewResources.MoneyLineNote</div>
	    </div>
    }
}
