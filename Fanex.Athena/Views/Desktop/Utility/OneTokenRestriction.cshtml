@{
    Layout = null;
    Page.Title = "Error!!!!!";
}
<!DOCTYPE html>
<html>
<head>
    <title>@Page.Title</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Error!!!!!</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/utility/error.css")" rel="stylesheet" />
    <style>
        body {
            font-family: Verdana,'sans-serif';
        }

        .center {
            margin: auto;
            width: 50%;
            padding: 10px;
        }

        ol {
            counter-reset: item;
        }

            ol li {
                display: block;
            }

                ol li:before {
                    content: counter(item) ". ";
                    counter-increment: item;
                    font-weight: bold;
                }
    </style>
</head>
<body>
    <div class="error-content">
        <img src="@Url.ContentLink("/www/assets/images/lap-restriction-page.png")" />
        <div class="center">
            <div>
                <strong>@Html.Raw(ViewResources.ErrorNotification)</strong>
            </div>
            <ol style="list-style-type: decimal;">
                @if (ViewBag.Message == ViewResources.OneTokenRestrictionDefaultMsg)
                {
                    <li>
                        Your internet connection might be temporally broken.
                    </li>
                    <li>
                        Your authorization may be no longer valid since web browser's caches are cleared.
                    </li>
                }
                <li style="color:red">
                    @Html.Raw(ViewBag.Message)
                </li>
            </ol>
            <div>
                @Html.Raw(ViewResources.TryLogin)
            </div>
            <ul style="list-style-type: none;">
                @Html.Raw(ViewResources.SolutionForRestriction)
            </ul>
        </div>
    </div>
</body>
</html>