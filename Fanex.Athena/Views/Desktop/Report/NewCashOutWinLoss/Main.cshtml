@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + ViewResources.CashOutWinLoss;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain;
@using Fanex.Athena.Service.Core.Common.Interfaces
@model Fanex.Athena.Model.Report.ViewModel.NewCashOutWinLossViewModel
@{
    var currencyService = DependencyResolver.Current.GetService<ICurrencyService>();

    var baseCurrencyList = currencyService.GetBaseCurrencyList().Select(c => new { value = c.Value, label = c.Value }).ToList();

    var selectedCurrency = string.Join(",", Model.CurrencyList.Select(x => x.Key).ToArray());
    string selectedSubsidiary = Model.ViewType == SubsidiaryViewType.MasterManagement ?
        string.Join(",", Model.SubsidiaryList.SelectMany(x => x.Children.Select(y => y.Value)).Distinct()) : string.Join(",", Model.SubsidiaryList.Select(x => x.Value));
    var selectedSport = string.Join(",", Model.SportList.Select(x => x.Key).ToArray());

    var minDate = Model.ReportSetting.MinDate;
    var maxDate = Model.ReportSetting.MaxDate;
    var cutOffDate = Model.ReportSetting.CutOffDateString;
}

@section pagecss {

    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/newcashoutwinloss/index.css")" rel="stylesheet" type="text/css" />

}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/newcashoutwinloss.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    selectedCurrency:  '@(selectedCurrency)',
    selectedBaseCurrency: '@(ViewBag.DefaultSelectedBaseCurrency)',
    selectedSubsidiary: '@(selectedSubsidiary)',
    selectedSport:  '@(selectedSport)',
    dateRange: {fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")'},
    isLoading: false,
    reloadReport: false
    }
    window._AppData = {
    cutOffDate: new Date('@cutOffDate'),
    subsidiaryList: @Html.Raw(Model.SubsidiaryList.ToJson()),
    sportList: @Html.Raw(Model.SportList.Select(x => new { Id = x.Key, Value = x.Value, Status = true }).ToJson()),
    viewType: @((byte)Model.ViewType),
    currencyList: @Html.Raw(Model.CurrencyList.Select(x => new { Id = x.Key, Value = x.Value, Status = true }).ToJson()),
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    dateConstraint: {minDate: '@minDate.ToString("MM/dd/yyyy")', maxDate: '@maxDate.ToString("MM/dd/yyyy")', limitedMonthRange: 3},
    defaultBaseCurrency: '@(ViewBag.DefaultSelectedBaseCurrency)',
    defaultSelectedSport:  '@(selectedSport)',
    IsLicenseeOfferBA: @Json.Encode(Model.IsLicenseeOfferBA)
    };
}
<div id="app-container">
</div>