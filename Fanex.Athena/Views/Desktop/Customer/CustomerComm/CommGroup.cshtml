@using Fanex.Athena.Controllers.Customer.Helpers;
@model Fanex.Athena.Model.Customer.MetaModel.GroupCommMetaModel
@{
    Layout = null;
    var comms = Model.CommValues;
}
<div class="row">
    <div class="col s12 text-bold input-field">
        @ViewResources.Commission (%)
    </div>
</div>

@for (int i = 0; i < Model.CommValues.Count(); i++)
{
    var comm = Model.CommValues.ElementAt(i);
    var dropdownId = comm.ProductCode + "CommDiscount";

    @Html.Hidden("CommValues[" + i + "].ProductCode", comm.ProductCode)
    @Html.Hidden("CommValues[" + i + "].ProductName", comm.ProductName)
    @Html.Hidden("CommValues[" + i + "].Sporttype", comm.Sporttype)
    @Html.Hidden("CommValues[" + i + "].Bettype", comm.Bettype)
    @Html.Hidden("CommValues[" + i + "].Discount", comm.Discount, new { id = dropdownId })

    <div class="row">
        <div class="col l2 m4 s12 input-field">
            @comm.ProductName
        </div>
        <div class="col l1 m2 s4 first-value">
            @DesktopGroupCommRazorHelper.CommDropDownFirst(dropdownId + "1", CustomerComGroupHelper.GetCommPart(comm.Discount, 1))
        </div>
        <div class="col l1 m2 s4">
            @DesktopGroupCommRazorHelper.CommDropDownSecond(dropdownId + "2", CustomerComGroupHelper.GetCommPart(comm.Discount, 2))
        </div>
        <div class="col l1 m2 s4 third-value">
            @DesktopGroupCommRazorHelper.CommDropDownThird(dropdownId + "3", CustomerComGroupHelper.GetCommPart(comm.Discount, 3))
        </div>
    </div>
}