@{
    ViewBag.Title = "LAP - " + ViewResources.LicenseeContacts;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DTO.Common;

@{
    var whitelabelList = ViewBag.SubsidiaryList as IEnumerable<CheckedItem>;
    var subsidiaryList = whitelabelList.SelectMany(x => x.Children.Select(y => y.Value)).Distinct();
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/licenseecontact/index.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/licenseecontact/licenseecontact.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    isLoading: false
    }

    window._AppData = {
    subsidiaryViewType: @ViewBag.SubsidiaryViewType,
    whitelabelList: @Html.Raw(whitelabelList.ToJson()),
    subsidiaryList: @Html.Raw(subsidiaryList.ToJson()),
    }
}
<div id="app-container">
</div>
