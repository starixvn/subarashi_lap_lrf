    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.4.2",
    "resolve-url-loader": "^2.3.2",
    "usehooks-ts": "^2.9.1",
    "uuid": "^8.3.2",
    "xlsx-style-sparta": "^0.8.21"
