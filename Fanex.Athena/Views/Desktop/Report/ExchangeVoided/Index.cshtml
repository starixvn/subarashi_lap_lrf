@using Fanex.Athena.Model.Core.DataDomain
@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + "Betting Tickets Center - Exchange";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@model bool

@{
    var hasPermission = Model;
    var baseCurrencyList = ((IDictionary<int, string>)ViewBag.BaseCurrencyList).Select(c => new { value = c.Value, label = c.Value }).ToList();
    var currencyList = ((IEnumerable<KeyValuePair<int, string>>)ViewBag.CurrencyList).Select(x => new { id = x.Key, value = x.Value, status = true });
    var selectedCurrency = string.Join(",", ((IEnumerable<KeyValuePair<int, string>>)ViewBag.CurrencyList).Select(x => x.Key).ToArray());
}

@if (hasPermission)
{
    var selectedTimeZone = SystemConstants.TimeZoneList.First().Key;
    var today = DateTime.Now.Date;
    var minDate = today.AddMonths(-1);

    @section pagecss {
        <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/exchangevoided/index.css")" rel="stylesheet" type="text/css" />
    }
    @section pagejs {
        <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/exchangevoided/exchangevoided.chunk.js")"></script>
    }

    @section globaljscode{
        window.initialState = {
        selectedCurrency:  '@(selectedCurrency)',
        selectedBaseCurrency: '@(ViewBag.SelectedBaseCurrency)',
        isConvertAll: 'true',
        requestParam: {
        refNo: '',
        userName: '',
        selectedDate: '@today.ToString("MM/dd/yyyy")'
        },
        dateConstraint: {minDate: '@minDate.ToString("MM/dd/yyyy")', maxDate: '@today.AddDays(2).ToString("MM/dd/yyyy")'},
        isLoading: false,
        selectedTimeZone: @selectedTimeZone,
        };

        window._AppData = {
        tabList: @Html.Raw((ViewBag.TabList as IEnumerable<string>).ToJson()),
        timeZoneList: @Html.Raw(SystemConstants.TimeZoneList.Select(x => new { value = x.Key, label = x.Value }).ToJson()),
        baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
        currencyList: @Html.Raw(currencyList.ToJson()),
        defaultBaseCurrency: '@(ViewBag.SelectedBaseCurrency)',
        defaultCurrency: '@(selectedCurrency)',
        defaultTimeZone: @selectedTimeZone,
        defaultDate: '@today.ToString("MM/dd/yyyy")',
        };
    }
    <div id="app-container"></div>
}
