    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerRunningBetListViewModel
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/betlist/index.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/playeradmin/running-betlist.css")" rel="stylesheet" type="text/css" />
