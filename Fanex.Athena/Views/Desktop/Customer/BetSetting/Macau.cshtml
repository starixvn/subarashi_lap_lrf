@model Fanex.Athena.Model.BetSettings.ViewModel.ThirdPartyBetSettingViewModel
@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/thirdpartybetsetting.chunk.js")"></script>
}
@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/_Menu.cshtml", Model);}
}
@section ContentTitle{
    @Model.Title
}
<!--Content-->
@if (Model.IsLineEnabled)
{
    <p class="no-info-row">@String.Format(ViewResources.CannotUpdateBetLimitForProduct, ViewResources.ProductVG)</p>
}
else
{
    <p class="no-info-row">@ViewResources.MacauNotOfferCurrency</p>
}
<!--/Content-->
<!--SubmitButton-->
@if (Model.Editable)
{
    <div class="right button-block">
        @if (Model.IsLineEnabled)
        {
            <button type="button" class="btn btn-submit"
                    data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 0 : 1)"
                    data-cust-id="@Model.Param.CustId"
                    data-nick-name="@Model.Param.NickName"
                    id="btnUpdateStatus">
                @(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? ViewResources.DisableMacau : ViewResources.EnableMacau)
            </button>
        }
    </div>
}
<!--/SubmitButton-->
