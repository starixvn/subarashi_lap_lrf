@model Fanex.Athena.Model.BetSettings.ViewModel.BetSettingViewModel
@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
    </tr>
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/numbergamebetsetting.chunk.js")"></script>
}
@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/_Menu.cshtml", Model);}
}
@section ContentTitle{
    @Model.Title
}

@Html.Hidden("IDList", String.Join(",", Model.MainData.Select(x => x.SportId)))
@Html.Hidden("editable", Model.Editable)
@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    const string FormatDecimal = "#,###,##0.##";

    <div class="table-content">
        <div class="header-content">
            <table class="table">
                <thead>
                    @RenderFirstRow()
                    <tr>
                        <th>@ViewResources.ProductNG</th>
                        <th>@ViewResources.MinBet</th>
                        <th>@ViewResources.MaxBet</th>
                        <th>@ViewResources.MaxPerMatch</th>
                        <th>@ViewResources.MaxPerBall</th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="body-content">
            <table class="table betsetting-form">
                <tbody>
                    @RenderFirstRow()
                    @foreach (var item in Model.MainData)
                    {
                        <tr>
                            <td>@item.BetSettingType</td>
                            <td>
                                <input id="min-bet-@(item.SportId)" type="text" maxlength="14" class="right-align"
                                       value="@item.MinBet.ToString(FormatDecimal)"
                                       data-min-value="@item.BetValueMin.ToString(FormatDecimal)"
                                       data-original="@item.MinBet.ToString(FormatDecimal)" />
                                @if (item.BetValueMin > 0)
                                {
                                    <span> &gt;=@item.BetValueMin.ToString(FormatDecimal)</span>
                                }
                            </td>
                            <td>
                                <input id="max-bet-@(item.SportId)" type="text" maxlength="14" class="right-align"
                                       value="@item.MaxBet.ToString(FormatDecimal)"
                                       data-max-value="@item.BetValueMax.ToString(FormatDecimal)"
                                       data-original="@item.MaxBet.ToString(FormatDecimal)" />
                                @if (item.BetValueMax > 0)
                                {
                                    <span>&lt;=@item.BetValueMax.ToString(FormatDecimal)</span>
                                }
                            </td>
                            <td>
                                <input id="max-per-match-@(item.SportId)" type="text" maxlength="14" class="right-align"
                                       value="@item.MaxPerMatch.ToString(FormatDecimal)"
                                       data-min-value="@item.MaxPerMatchMin.ToString(FormatDecimal)"
                                       data-max-value="@item.MaxPerMatchMax.ToString(FormatDecimal)"
                                       data-original="@item.MaxPerMatch.ToString("#,###,##.##")" />
                                @if (item.MaxPerMatchMax > 0)
                                {
                                    <span>&lt;=@item.MaxPerMatchMax.ToString(FormatDecimal)</span>
                                }
                            </td>
                            <td>
                                <input id="max-per-ball-@(item.SportId)" type="text" maxlength="14" class="right-align"
                                       value="@item.MaxPerBall.ToString(FormatDecimal)"
                                       data-max-value="@item.MaxPerBallMax.ToString(FormatDecimal)"
                                       data-original="@item.MaxPerBall.ToString(FormatDecimal)" />
                                @if (item.MaxPerBallMax > 0)
                                {
                                    <span>&lt;=@item.MaxPerBallMax.ToString(FormatDecimal)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!--SubmitButton-->
    if (Model.Editable)
    {
        <div class="right button-block">
            <button type="button" class="btn btn-submit"
                    data-cust-id="@Model.Param.CustId"
                    data-user-name="@Model.Param.UserName"
                    data-nick-name="@Model.Param.NickName"
                    id="btnSubmitBetSetting">
                @ViewResources.Submit
            </button>
            <button type="button" class="btn btn-cancel" id="btnReset">@ViewResources.Reset</button>
        </div>
    }
    <!--/SubmitButton-->
}
