@{
    ViewBag.Title = string.Format("LAP - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}

@using Fanex.Athena.VendorAdapter;
@model Fanex.Athena.Model.BetList.MetaModel.BetListMetaModel
@{
    var _cacheRefAdapter = new CacheRefAdapter();
}
@section pagecss {}
@section pagejs {}
@section ContentTitle
{
    <span class="league-name-title"></span>@(Model.BetType == 0 ? ViewResources.AllBetTypes : _cacheRefAdapter.GetBettype(Model.BetType)) <span class="base-currency">-@DesktopRazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
}
@section BackButton
{

}
@{
    <input type="hidden" id="ApiUrl" value="Proxy/Betlist/api_RunningMatchChoiceBetList_GetData" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="winloss,licenseewl" />
}
