<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="$(SolutionDir)\packages\Microsoft.Web.Xdt.3.1.0\lib\net40\Microsoft.Web.XmlTransform.dll" #>
<#@ import namespace="System.Xml" #>
<#@ output extension=".txt" #>
<#
string projectPath = Host.ResolveAssemblyReference("$(SolutionDir)") + @"Fanex.Athena\";
var environments = new string[] {"DEV", "LOCAL", "UAT", "UATTW", "SIT", "Staging", "PROD", "PRODStatic" };
foreach(var environment in environments)
{
 using(var transform = new Microsoft.Web.XmlTransform.XmlTransformation( projectPath + "SiteConfig\\WebConfigTransforms\\" + environment + ".config"))
 {
 var document = new XmlDocument();
 document.Load(projectPath + "Web.config");
 transform.Apply(document);
 document.Save(projectPath + "SiteConfig\\Web." + environment + ".config");
 }
}
#>

