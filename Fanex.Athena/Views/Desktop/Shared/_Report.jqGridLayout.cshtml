@{
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@section css
{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/reports/reportjqgridlayout.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/lib/jqgrid.chunk.js")"></script>
    @RenderSection("pagejs", required: false)
}
<div id="report-container">
    @RenderSection("Header", required: false)
    @RenderSection("Filter", required: false)
    @RenderSection("Content", required: false)
</div>

<div class="page-portal">
    <div class="toast-container toast-container-top toast-container-right">
        <div class="toast-align">
        </div>
    </div>
</div>