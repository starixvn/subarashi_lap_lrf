@using Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerBatchUpdate;
@model BasePlayerBatchUpdateViewModel
@{
    ViewBag.Title = "LAP - " + ViewResources.UpdateBAStatus;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/playerBatchUpdate/index.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/playerBatchUpdate/baStatus.chunk.js")"></script>
}
@section Filter
{
    <div class="row page-form">
        <form class="player-ba-status-edit" id="player-ba-status-edit"
              action""
              method="post">
            <div class="row">
                <div class="input-field col l3 m6 s6">
                    <label>@ViewResources.SelectedCustomers</label>
                </div>
                <div class="input-field col l3 m5 s5">
                    <label>@ViewResources.BAStatus</label>
                </div>
                <div class="input-field col l3 m1 s1 ">
                    <i class="icon-info right" title="@(ViewResources.MessageLimitTimeUpdateBA + "\r\n"+ ViewResources.MessageTurnOffVIPError)"></i>
                </div>
            </div>
            <div class="row">
                <div class="input-field col l3 m6 s6">
                    <div class="multiselect-container">
                        <select id="ddl-customers"></select>
                    </div>
                </div>
                <div class="input-field col l3 m6 s6">
                    <div class="wrapper tri-state-toggle">
                        <div class="tgl-on" title="@ViewResources.On"></div>
                        <div class="tgl-none selected" title="@ViewResources.None"></div>
                        <div class="tgl-off" title="@ViewResources.Off"></div>
                        <div class="toggle"></div>
                    </div>
                </div>
            </div>
            @Html.Hidden("CustNames", Model.CustNamesStr)
            @Html.Hidden("CustIds", Model.CustIdsStr)
        </form>
    </div>
}
@section Content
{ <div class="div-content">
        <div class="row">
            <div class="input-field col l6 m12 s12 msg-on-ba-status hide">
                @ViewResources.ConfirmBatchUpdateBAStatus_On
            </div>
            <div class="input-field col l6 m12 s12 msg-off-ba-status hide">
                @ViewResources.ConfirmBatchUpdateBAStatus_Off
            </div>
        </div>
        <div class="row">
            <div class="col l6 m12 s12">
                <div id="div-result" class="div-result hide">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="input-field col l6 m12 s12">
                <div class="btn-group">
                    <button type="button" disabled="disabled" class="btn btn-submit">@ViewResources.Save</button>
                    <button type="button" class="btn btn-cancel">@ViewResources.Cancel</button>
                </div>
            </div>
        </div>
    </div>
}
