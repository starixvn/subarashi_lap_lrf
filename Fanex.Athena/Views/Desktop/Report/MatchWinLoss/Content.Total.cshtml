@using Fanex.Athena.VendorAdapter;
@model Fanex.Athena.Model.Report.ViewModel.MatchWinLossViewModel
@{
    var _cacheRefAdapter = new CacheRefAdapter();
    var dataTotal = Model.Total;

    if (Model.MainResult.Count > 0)
    {
        <tr>
            <td colspan="2" class="text-bold">
                @ViewResources.Total
            </td>
            <td class="right-align text-bold">
                @NumberHelper.DecFormat(@dataTotal.Turnover)
            </td>
            <td class="right-align text-bold">
                @dataTotal.TotalTransaction.ToString("#,###")
            </td>
            @if (Model.IsAllowedCustomerCommission)
            {
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(@dataTotal.CustomerWL)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(@dataTotal.CustomerComm)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(@dataTotal.CustomerWL + @dataTotal.CustomerComm)
                </td>
            }
            else
            {
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(@dataTotal.CustomerWL)
                </td>
            }
            <td class="right-align text-bold">
                @DesktopRazorHelper.NegativeFormat(dataTotal.LicenseeWL)
            </td>

            @if (Model.ProductAccess.IsAllowBA)
            {
                <td class="right-align text-bold">
                    @DesktopRazorHelper.NegativeFormat(dataTotal.BACommission)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(@dataTotal.AmtDueToBA, 2)
                </td>
            }
        </tr>
    }

    var dataListOutright = Model.SpecialBetTypeResult;
    // Display information for outright and mixparlay
    foreach (var itemOutRight in dataListOutright)
    {
        <tr>
            <td colspan="2" class="text-bold">
                <a href="javascript:;" class="outright-link" data-bettype="@itemOutRight.BetType">
                    @_cacheRefAdapter.GetBettypeWithProductName(itemOutRight.BetType, itemOutRight.ProductCode)
                </a>
            </td>
            <td class="right-align text-bold">
                @NumberHelper.DecFormat(itemOutRight.Turnover)
            </td>
            <td class="right-align text-bold">
                @itemOutRight.TotalTransaction.ToString("#,###")
            </td>
            @if (Model.IsAllowedCustomerCommission)
            {
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(itemOutRight.CustomerWL)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(itemOutRight.CustomerComm)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(itemOutRight.CustomerWL + itemOutRight.CustomerComm)
                </td>
            }
            else
            {
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(itemOutRight.CustomerWL)
                </td>
            }
            <td class="right-align text-bold">
                @DesktopRazorHelper.NegativeFormat(itemOutRight.LicenseeWL)
            </td>
            @if (Model.ProductAccess.IsAllowBA)
            {
                <td class="right-align text-bold">
                    @DesktopRazorHelper.NegativeFormat(itemOutRight.BACommission)
                </td>
                <td class="right-align text-bold">
                    @NumberHelper.DecFormat(itemOutRight.AmtDueToBA)
                </td>
            }
        </tr>
    }
}