@using Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerCommission;
@model MultipleUpdateGroupViewModel
@{
    ViewBag.Title = "LAP - " + ViewResources.UpdateCommissionValue;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/playercommission/index.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/playercommission/multipleupdategroup.chunk.js")"></script>
}
@section Filter
{
    <div class="row page-form">
        <form class="customer-comm-group-edit" id="customer-comm-group-edit"
              action""
              method="post">
            <div class="row">
                <div class="input-field col l6 m12 s18">
                    <label>@ViewResources.SelectedCustomers</label>
                </div>
            </div>
            <div class="row">
                <div class="input-field col l6 m12 s18">
                    <div class="multiselect-container">
                        <select id="ddl-customers"></select>
                    </div>
                </div>
            </div>
            @Html.Hidden("CustNames", Model.CustNamesStr)
            @Html.Hidden("CustIds", Model.CustIdsStr)
            @Html.Hidden("Products", string.Join(",", Model.ProductPermissions.Select(p => p.Key)))
        </form>
    </div>
}
@section Content
{
    <div class="div-content">
        <div class="row">
            <div class="input-field col l6 m12 s18">
                <table id="tbl-comm" class="table tbl-comm elm-update-comm">
                    <thead class="">
                        <tr>
                            <th> @ViewResources.Product</th>
                            <th class="col-comm"> @ViewResources.Commission (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.ProductPermissions)
                        {
                            if (!p.Value)
                            {
                                continue;
                            }
                            <tr>
                                <td>@ViewResources.ResourceManager.GetString("Product" + p.Key)</td>
                                <td class="text-center">
                                    <div class="col l4 m4 s4 input-field first-value">
                                        @DesktopGroupCommRazorHelper.CommDropDownFirst("comm1-" + p.Key)
                                    </div>
                                    <div class="col l4 m4 s4 input-field">
                                        @DesktopGroupCommRazorHelper.CommDropDownSecond("comm2-" + p.Key)
                                    </div>
                                    <div class="col l4 m4 s4 input-field third-value">
                                        @DesktopGroupCommRazorHelper.CommDropDownThird("comm3-" + p.Key)
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col l6 m12 s18">
                <div id="div-result" class="div-result hide">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="input-field col l6 m12 s18">
                <div class="btn-group">
                    <button type="button" class="btn btn-submit">@ViewResources.Save</button>
                    <button type="button" class="btn btn-cancel">@ViewResources.Cancel</button>
                </div>
            </div>
        </div>
    </div>
}
