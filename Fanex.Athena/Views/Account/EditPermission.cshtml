@{
    Layout = null;
}

@model Fanex.Athena.Model.Core.MetaModel.Account.EditPermissionMetaModel

<div id="function-tab">
    @using (Html.BeginForm("EditPermission", "AccountPermission", FormMethod.Post, new { id = "EditPermissionForm" }))
    {
        <div class="permissionBox">
            @if (Model.AllMasterFunctions != null && Model.AllFunctionMap != null && Model.AllUserFunctions != null)
            {
                string check;
                var expandImage = Url.ContentLink("/Resources/Images/expand.png");
                foreach (var masterFunction in Model.AllMasterFunctions)
                {
                    check = string.Empty;
                    var foundMap = Model.AllFunctionMap
                       .Where(f => f.Key == masterFunction.FunctionId)
                       .SingleOrDefault();

                    var hasNoSubFunctions = foundMap.Key == 0 || masterFunction.FunctionId == 6;

                    if (Model.AllUserFunctions.Any(f => f.FunctionId == masterFunction.FunctionId))
                    {
                        check = "checked=checked";
                    }

                    <!-- write this master function -->
            <div class="masterItem">
                @if (!hasNoSubFunctions)
                {
                    <img class="icon" id="@string.Format("img{0}", masterFunction.FunctionId)" src="@expandImage" )"
                         onclick="EditPermission.collapseExpand(this)" data-status="collapse" />
                }

                <input type="checkbox" id="@masterFunction.FunctionId" onclick="EditPermission.checkedChange(this)" class="parentCheckBox @(hasNoSubFunctions ? "no-sub" : "")" @check>
                <label for="@masterFunction.FunctionId">@masterFunction.Name</label>
            </div>
                
                    <!-- write its sub function -->
                   
                    if (!hasNoSubFunctions)
                    {
                        var subFunctionList = foundMap.Value;
                        <div id="@string.Format("group_img{0}", masterFunction.FunctionId)" class="groupStyle">
                        @foreach (var subFunction in subFunctionList)
                        {
                            check = string.Empty;
                            if (Model.AllUserFunctions.Any(f => f.FunctionId == subFunction.FunctionId))
                            {
                                check = "checked=checked";
                            }
                    
                            <div class="funcItem">
                                <input @check type="checkbox" id="@subFunction.FunctionId"
                                    onclick="EditPermission.childCheckedChange(@masterFunction.FunctionId)" />
                                <label for="@subFunction.FunctionId">@subFunction.Name</label>
                            </div>
                        }
                        </div>
                    }
            
                    <br />
                }
            }

            @Html.HiddenFor(m => m.UserId)
        </div>
    }
    </div>