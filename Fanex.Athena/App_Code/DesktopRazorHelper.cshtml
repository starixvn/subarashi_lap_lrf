@helper CurrencyList(IDictionary<int, string> currencyList,
string className = "", int selected = 0,
bool addMoreAllOption = true,
bool addBasedOption = false)
{

    var selectedName = currencyList.Where(p => p.Key == selected).FirstOrDefault().Key;
    var selectedBaseCurrency = SystemConstants.BaseCurrencyList
    .FirstOrDefault(i => i.Key == selected).Value;
    if (string.IsNullOrEmpty(selectedBaseCurrency))
    {
        selectedBaseCurrency = string.Empty;
    }
    var items = currencyList
                     .Select(c => new System.Web.WebPages.Html.SelectListItem
                     {
                         Value = c.Key.ToString(),
                         Text = c.Value,
                         Selected = selected == c.Key
                     }).ToList();
    if (addBasedOption)
    {

        foreach (var currency in SystemConstants.BaseCurrencyList)
        {

            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.Based + " " + currency.Value,
                Value = currency.Key.ToString(),
                Selected = currency.Key == selected
            });
        }
    }
    if (addMoreAllOption)
    {
        items.Insert(0, new System.Web.WebPages.Html.SelectListItem
        {
            Text = ViewResources.All.ToUpper(),
            Value = BaseCurrencyType.All.ToString(),
            Selected = BaseCurrencyType.All == selected
        });
    }
    <input type="hidden" id="CurrencyName" name="CurrencyName" value="@selectedName" data-original="@selectedName" />
    if (addBasedOption)
    {
        <input type="hidden" id="BaseCurrency" name="BaseCurrency" value="@selectedBaseCurrency" data-original="@selectedBaseCurrency" />
    }
    <select name="CurrencyId" id="CurrencyId" class="@className hide" data-original="@selected">
        @foreach (var item in items)
        {
            <option value="@item.Value" @(item.Selected ? new HtmlString("selected=selected") : new HtmlString(""))>@item.Text</option>
        }
    </select>
}

@helper BasedCurrency(string selectedBasedCurrency = "", string CurrencyName = null)
{
    <select class="based-currency hide" name="BaseCurrency" id="BaseCurrency" data-original="@selectedBasedCurrency">
        @foreach (var item in SystemConstants.BaseCurrencyList)
        {
            <option value="@item.Value.ToLowerInvariant()" @(selectedBasedCurrency.Equals(item.Value, StringComparison.OrdinalIgnoreCase) ? "selected='selected'" : string.Empty)>@item.Value</option>
        }
        <option value="" @(selectedBasedCurrency == "" ? new HtmlString("selected=selected") : new HtmlString(""))>@CurrencyName</option>
    </select>
    <input type="hidden" id="defaultBaseCurrency" value="@selectedBasedCurrency" />
}
