<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
    </appender>
  </log4net>
  <system.web>
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
    <httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="2097151" maxQueryStringLength="2097151" enable="true" xdt:Transform="Replace" />
    <sessionState mode="StateServer" cookieName=".lrf.session.uat" timeout="1400" stateConnectionString="tcpip=10.99.99.101:42424" cookieless="false" xdt:Transform="Replace"  />
    <!--<sessionState mode="Custom" cookieName="__lap_b_report" customProvider="LRFAppSessionStateStore" xdt:Transform="Replace" >
      <providers>
        <add name="LRFAppSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" applicationName="lrf_state" host="10.99.99.101" port="6379" accessKey="" ssl="false"  xdt:Transform="Replace" />
      </providers>
    </sessionState>-->
    <machineKey validationKey="5276329D600F4F7F3BF6EE6014BA1BC33AA9D9AD294CDCFF3F01C8018CF1875ED9555C0C0FBB87464BD6EE4F9F2FB0F6AE9E5B1C188860DDEE68609FB9A724A5" decryptionKey="93B3E01D870883ECD43F1330C9DB80D0575465372BB302990CCB4E028FEEE414" validation="SHA1" decryption="AES" xdt:Transform="InsertAfter(/configuration/system.web/sessionState)" />
    <httpHandlers>
      <add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert"/>
    </httpHandlers>
  </system.web>
</configuration>
