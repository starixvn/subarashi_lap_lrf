<!--Delete group template-->
@using Fanex.Athena.Model.Customer.ViewModel.CustomerLog
@using Fanex.Athena.Api.CustomerLog;
@using Fanex.Athena.Model.Core.Helper;
@using Fanex.Common;
@model ActionViewModel
@{
    Model.Resource = LogHelper.GetGroupCommissionLogResources(ActionViewModel.ProductPermissions);
    var groupNameOld = Model.Data["GroupNameOld"];
    const int nameLength = LogHelper.MaxCommissionGroupNameShownLength;
    var groupNameOldTitle = groupNameOld.Length > nameLength ? "title='" + groupNameOld + "'" : "";

    var columnNames = CommissionGroupHelper.MapHardcodedNameFromDB(ActionViewModel.ProductPermissions, false);
    var numberOfTable = Math.Ceiling(((decimal)(ActionViewModel.ProductPermissions.Count - 3)) / 7);
    var productIndex = LogHelper.ProductInFirstRow;
}
@helper RenderCommValue(int index, IDictionary<string, string> columnNames)
{
    var p = ActionViewModel.ProductPermissions.ElementAt(index);

    var fieldName = columnNames[p.Key] + "Comm";
    var fieldNameOld = fieldName + "Old";

    var value = Converter.ToDecimal(Model.Data[fieldName]);
    var oldValue = Converter.ToDecimal(Model.Data[fieldNameOld]);

    <td title="@Model.TitleOfChange(fieldName, LogHelper.CommFormat)">
        <p>@value.ToString(LogHelper.CommFormat)</p>
        <p class="@Model.GetClassName(fieldName)">@oldValue.ToString(LogHelper.CommFormat)</p>
    </td>
}
<table class="nested-table tbl-group-comm">
    <tbody>
        <tr class="row-title">
            <td class="col-commission">@Model.Resource["GroupId"]</td>
            <td class="col-commission">@Model.Resource["GroupName"]</td>
            <td class="col-commission">@Model.Resource["GroupColor"]</td>
            <td class="col-commission">@Model.Resource["DefaultGroup"]</td>
            @for (var i = 0; i < LogHelper.ProductInFirstRow && i < ActionViewModel.ProductPermissions.Count; i++)
            {
                var p = ActionViewModel.ProductPermissions.ElementAt(i);
                <td class="col-commission">@Model.Resource[p.Key + "Comm"]</td>
            }
        </tr>
        <tr>
            <td>@Model.Data["GroupCommID"]</td>
            <td>
                <p>@Model.Display("GroupName", nameLength)</p>
                <p class="@Model.GetClassName("GroupName")" @Raw(groupNameOldTitle)>@Model.Display("GroupNameOld", nameLength)</p>
            </td>
            <td>
                <p style="background-color:@Model.Data["GroupColor"];" class="group-color-box"></p>
                <div class="@Model.GetClassName("GroupColor")">
                    <p title="@Model.Resource["OldColor"]" style="background-color:@Model.Data["GroupColorOld"];" class="group-color-box"></p>
                </div>
            </td>
            <td>
                <p>@Model.DisplayYesNo("IsDefault")</p>
                <p class="@Model.GetClassName("IsDefault")">@Model.DisplayYesNo("IsDefaultOld")</p>
            </td>
            @for (var i = 0; i < LogHelper.ProductInFirstRow && i < ActionViewModel.ProductPermissions.Count; i++)
            {
                @RenderCommValue(i, columnNames)
            }
        </tr>
        @for (var t = 0; t < numberOfTable; t++)
        {
            var i = 0;
            <tr class="row-title">
                @for (i = 0; i < 7 && productIndex + i < ActionViewModel.ProductPermissions.Count; i++)
                {
                    var p = ActionViewModel.ProductPermissions.ElementAt(productIndex + i);

                    <td>@Model.Resource[p.Key + "Comm"]</td>
                }
                @if (i < 7)
                {
                    <td colspan="@(7-i)"></td>
                }
            </tr>
            <tr>
                @for (i = 0; i < 7 && productIndex + i < ActionViewModel.ProductPermissions.Count; i++)
                {
                    @RenderCommValue(productIndex + i, columnNames)
                }
                @if (i < 7)
                {
                    <td colspan="@(7-i)"></td>
                }
            </tr>

            productIndex += 7;
        }
    </tbody>
</table>
