@{
    ViewBag.Title = "LAP - Player Administrator - Customer Win Loss";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerFastCrossLinkViewModel
@{
    var now = DateTime.Now;
    var fromDate = new DateTime(now.Year, now.Month, 1).ToString("MM/dd/yyyy");
    var toDate = now.ToString("MM/dd/yyyy");

    const string TitlePattern = "{0}: {1}, {2}→{3}, {4}: {5}, {6}: {7}";
    var reportTitle = string.Format(TitlePattern,
        ViewResources.Player, Model.UserName,
        fromDate, toDate,
        ViewResources.Currency, Model.CurrencyName,
        ViewResources.Product, Model.ProductCodeListString);
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/playeradmin/playerwinloss.css")" rel="stylesheet" type="text/css" />
    <style>
        #app-container {
            margin-top: 10px;
        }
    </style>
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/playeradmin/playerwinloss.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    isLoading: false,
    requestParam: {userName: '@Model.UserName'},
    hasCustomerComm: '@Model.IsAllowedCustomerCommission.ToString()' === 'True',
    isAllowedBA: '@Model.IsAllowedBA.ToString()' === 'True'
    };

    window._AppData = {
    reportTitle: '@reportTitle'
    };
}
<div id="app-container">
</div>