@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + ViewResources.SubsidiaryPerformance;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain;
@model Fanex.Athena.Model.Report.ViewModel.SubsidiaryPerformanceViewModel
@{
    var productOptions = Model.ProductOptionList;
    var selectedProductCode = string.Join(",", productOptions.Where(x => x.Status).Select(x => x.Code).ToArray());
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new { value = c.Value, label = c.Value }).ToList();

    var selectedSubsidiary = Model.ViewType == (byte)SubsidiaryViewType.MasterManagement
        ? string.Join(",", Model.GroupSubsidiaryList.SelectMany(x => x.Children.Select(y => y.Value)).Distinct())
        : string.Join(",", Model.GroupSubsidiaryList.Select(x => x.Value));

    var selectedWhiteLable = Model.ViewType == (byte)SubsidiaryViewType.MasterManagement
        ? string.Join(",", Model.GroupSubsidiaryList.Select(x => x.Value))
        : string.Empty;

    var appSettings = new AppSettings();
    var minDate = appSettings.HistoryDate;
    var maxDate = appSettings.MaxDate;
}

@section pagecss {

<link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/subsidiaryperformance/index.css")" rel="stylesheet" type="text/css" />

}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/subsidiaryperformance/subsidiaryperformance.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
        selectedProduct: '@(selectedProductCode)',
        selectedBaseCurrency: '@ViewBag.DefaultSelectedBaseCurrency',
        selectedSubsidiary: '@(selectedSubsidiary)',
        selectedWhiteLabel: '@(selectedWhiteLable)',
        convertAll: false,
        dateRange: {fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")'},
        isLoading: false,
        includeDrawData: true,
        isExcludeTest: true
    };
    window._AppData = {
        productOptions: @Html.Raw(productOptions.ToJson()),
        baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
        subsidiaryList: @Html.Raw(Model.GroupSubsidiaryList.ToJson()),
        dateConstraint: {minDate: '@minDate.ToString("MM/dd/yyyy")', maxDate: '@maxDate.ToString("MM/dd/yyyy")'},
        viewType: @Model.ViewType
    };
}
<div id="app-container">

</div>
