@model Fanex.Athena.Model.Report.ViewModel.LicenseeWinLossViewModel
@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + ViewResources.LicenseeWinLoss;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/reports/licenseewinloss.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/reports/licenseewinloss.chunk.js")"></script>
}

@section Header
{
    @if (!Model.IgnoreSharding)
    {
        Html.RenderPartial("~/Views/Desktop/Report/LicenseeWinLoss/Tab.cshtml");
    }
}

@section Filter
{
    @{Html.RenderPartial("~/Views/Desktop/Report/LicenseeWinLoss/Filter.cshtml");}
}

@section Content
{
    @{Html.RenderPartial("~/Views/Desktop/Report/LicenseeWinLoss/Content.cshtml");}
}