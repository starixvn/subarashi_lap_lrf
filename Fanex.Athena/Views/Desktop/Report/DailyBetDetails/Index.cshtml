@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + ViewResources.DailyBetDetails;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DataDomain;
@model Fanex.Athena.Model.Report.ViewModel.DailyBetDetailsViewModel
@{

    var today = Model.TodayByGmt8;
    var minDate = Model.MinDate.ToString("dd/MM/yyyy");
    var maxDate = today.ToString("dd/MM/yyyy");
    var todayString = today.ToString("MM/dd/yyyy");
    var currencyList = Model.CurrencyList.Select(x => new { Key = x.Key, Value = x.Value, Status = true });
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/dailybetdetails/index.css")" rel="stylesheet" type="text/css" />

}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/dailybetdetails.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    isLoading: false,
    today: '@todayString',
    dateConstraint: {minDate: '1/1/2023', maxDate: '@maxDate'}
    }
    window._AppData = {
    currencyList: @Html.Raw(currencyList.ToJson()),
    };
}
<div id="app-container">
</div>