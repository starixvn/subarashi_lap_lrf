@using Fanex.Athena.Service.Core.Users.Interfaces;
@{
    Layout = null;
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
}
<div class="header-tab">
    <ul class="tabs">
        <li class="tab">
            <a href="@Url.Action("Index", "CustomerComGroup")" id="commissionGroupListTab">
                @ViewResources.CommissionGroupList
            </a>
        </li>
        @if (hasCustComm)
        {
            <li class="tab"><a href="@Url.Action("GroupCommission", "CustomerLog")" id="groupcommlogTab" class="active">@ViewResources.Log</a></li>
        }
    </ul>
</div>
