@{
    ViewBag.Title = string.Format("LAP - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}

@using Fanex.Athena.VendorAdapter;
@model Fanex.Athena.Model.BetList.MetaModel.LiveReportBetListMetaModel
@{
    var _cacheRefAdapter = new CacheRefAdapter();
}
@section pagecss {}
@section pagejs {}
@section ContentTitle
{
    @{
        var matchName = Model.HomeId > 0 && Model.AwayId > 0
          ? _cacheRefAdapter.GetTeamName(Model.HomeId, Model.SportType) + " vs " + _cacheRefAdapter.GetTeamName(Model.AwayId, Model.SportType) + " - "
          : string.Empty;

        var betTypeName = _cacheRefAdapter.GetBettype(Model.BetType);
        if (!string.IsNullOrWhiteSpace(betTypeName))
        {
            betTypeName = betTypeName + " -";
        }
    }
    @ViewResources.BetList - @matchName@_cacheRefAdapter.GetBettype(Model.BetType) @Model.FromDate.ToShortDateString()<span class="header-title-arrow">→</span>@Model.ToDate.ToShortDateString() - <span class="base-currency">@DesktopRazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
}
@section BackButton
{
    <a href="javascript:window.history.back();" class="icon-back"></a>
}
@{
    <input type="hidden" id="ApiUrl" value="api/LiveReportBetList/Match" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
}