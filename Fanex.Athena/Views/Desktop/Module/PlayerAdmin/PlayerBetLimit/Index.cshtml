@{
    ViewBag.Title = "LAP - Player Administrator Bet Limit";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Athena.Module.PlayerAdmin.ViewModels.PlayerBetLimitProductViewModel
@{
    var productList = Model.ProductList.Select(c => new { value = c.Key, label = c.Value }).ToList();
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/playeradmin/betlimit.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/playeradmin/betlimit.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    requestParam: { CustId: @Model.CustId, ProductId: @Model.ProductId, CurrencyId: @Model.CurrencyId, LicenseeCustId: @Model.LicenseeCustId }
    };
    window._AppData = {
    productList: @Html.Raw(productList.ToJson())
    };
}
<div id="app-container">
</div>