@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Fanex.Athena.Resources.ViewResources.UnderMaintenance</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/um.css")" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="img">
            <img src="@Url.ContentLink("/www/css/build/images/UM.png")" />
        </div>
        <div class="caption">
            <p>Risk & Forecast System servers are currently</p>
            <p>unavailable and scheduled to be back at </p>
            <p>@ViewBag.UmTimeTo (HK Time GMT +8).</p>
            <p>We apologize for the inconvenience.</p>
            <p>Thank you for your patience.</p>
        </div>
    </div>
    <script type="text/javascript">
        if (window.parent != window) {
            var sameOrigin;
            try {
                sameOrigin = window.parent.location.host == window.location.host;
            }
            catch (e) {
                sameOrigin = false;
            }
            sameOrigin && (window.parent.location = location.href);
        }
    </script>
</body>
</html>