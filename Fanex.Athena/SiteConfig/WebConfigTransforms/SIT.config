<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
    </appender>
  </log4net>
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />
    <httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" xdt:Transform="Replace" />
    <sessionState mode="StateServer" cookieName="__lap_b_report" timeout="25" stateConnectionString="tcpip=172.16.4.106:42424" cookieless="false" xdt:Transform="Replace"  />
    <machineKey validationKey="5276329D600F4F7F3BF6EE6014BA1BC33AA9D9AD294CDCFF3F01C8018CF1875ED9555C0C0FBB87464BD6EE4F9F2FB0F6AE9E5B1C188860DDEE68609FB9A724A5" decryptionKey="93B3E01D870883ECD43F1330C9DB80D0575465372BB302990CCB4E028FEEE414" validation="SHA1" decryption="AES" xdt:Transform="InsertAfter(/configuration/system.web/sessionState)" />
    <httpHandlers>
      <add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert"/>
    </httpHandlers>
  </system.web>
  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="01:00" UMTo="23:00" SiteId="2000001" UMPageUrl="~/Utility/UnderMaintenance" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>