@{
    Layout = null;
}
@model Fanex.Athena.Model.Core.ViewModel.HeaderPageViewModel

@{
    var showSubsidiarySearch = Model.SubsidiaryList.IsPresent();
}

<nav class="nav-wrapper">
    <a href="javascript:;" class="logo">
        <span class="logo-text hide-on-med-and-down"><img src="@Url.ContentLink("/www/assets/images/logo-text.svg")" /></span>
        <span class="icon-hambuger toggleMenubar" id="js-toggleMenubar" data-activates="nav-mobile">
            <span class="lines"></span>
        </span>
    </a>
    <div class="page-title"><span id="page-title" class="active">@ViewResources.Balance</span></div>
    <div class="right-block">

        <div class="navbar-avatar">
            <a class="dropdown-button" href="javascript:void(0)" data-activates="profile">
                <img class="avatar" src="@Url.ContentLink("/www/assets/images/15.jpg")" alt="@Html.Encode(Model.UserName)">
                <span class="name hide-on-med-and-down">@Html.Encode(Model.UserName)</span>
                <i class="icon icon-menu-down" aria-hidden="true"></i>
            </a>

            @if (!Model.IsInternalLogin)
            {
                <ul id="profile" class="dropdown-content profile-items">
                    <li>
                        <i class="icon icon-account"></i>
                        <a href="@Url.Content("~/Authorization/ChangePassword")" target="main">@ViewResources.ChangePassword</a>
                    </li>
                    <li>
                        <i class="icon icon-logout"></i>
                        <a href="@Url.Content("~/Authorization/SignOut")">@ViewResources.Logout</a>
                    </li>
                </ul>
            }
        </div>

        @if (showSubsidiarySearch)
        {
            <div class="subsidiary-dropdown-block hide" id="subsidiary-view">
                <div class="multiselect-container">
                    <select id="subsidiary-multiselect" name="subsidiary-multiselect"></select>
                </div>
            </div>
            <div class="subsidiary-search-block">
                <input id="IsViewOnSubsidiary" type="checkbox" />
                <label for="IsViewOnSubsidiary">
                    @ViewResources.SubsidiarySearch
                </label>
                <div class="tooltip-subsidiary">
                    <b>@ViewResources.ViewSubsidiaryOnReports: </b>
                    <ul>
                        <li>
                            @ViewResources.Report >> @ViewResources.LicenseeWinLoss
                        </li>
                        <li>
                            @ViewResources.Report >> @ViewResources.WinLossByBetType
                        </li>
                        <li>
                            @ViewResources.Report >> @ViewResources.WinLossByProduct
                        </li>
                        <li>
                            @ViewResources.Report >> @ViewResources.MatchWinLoss
                        </li>
                        <li>
                            @ViewResources.Report >> @ViewResources.PlatformWinLoss
                        </li>
                        <li>
                            @ViewResources.CustomerReports >> @ViewResources.CustomerSupportTask
                        </li>
                    </ul>
                </div>
            </div>
        }

        @if (Model.LicenseeList.Count > 1)
        {
            <div class="licensees-block s2-selectSite">
                <select id="ddlLicensee" name="ddlLicensee" class="select-licensee hide">
                    @foreach (var licensee in Model.LicenseeList)
                    {
                        var selectedStr = licensee.Id == Model.CurrentLicenseeId ? "selected=\"selected\"" : string.Empty;
                        <option value="@licensee.Id" @selectedStr>@licensee.Name</option>
                    }
                </select>
            </div>
        }

        <div class="languages-block">
            @{
                var currentLanguage = Model.SupportedLanguageList.FirstOrDefault(p => p.Key.Equals(Model.Language)).Value;
            }
            <a class="dropdown-button" href="javascript:void(0)" data-activates="languagesite">
                <span class="flag-icon flag-icon-@Model.Language"></span>
                @currentLanguage
                <i class="icon icon-menu-down" aria-hidden="true"></i>
            </a>

            <ul id="languagesite" class="dropdown-content language-items">
                @foreach (var language in Model.SupportedLanguageList)
                {
                    <li>
                        <a href="javascript:void(0)" class="languageItem" langkey="@language.Key">
                            <span class="flag-icon flag-icon-@language.Key"></span> @language.Value
                        </a>
                    </li>
                }
            </ul>
        </div>

        @if (Model.IsAllowedNotification)
        {
            <div class="notifications-block">
                <a class="notification-button" href="javascript:void(0)">
                    <i class="icon-notification"></i>
                </a>

                <ul id="notificationmsg" class="notification-content">
                    <li class="first-notification"></li>
                </ul>
            </div>
        }
    </div>

    <div class="clock-block">
        <span class="icon-clock"></span><span id="clock"></span>@DateTime.Now.ToString("%z")
    </div>
    @if (showSubsidiarySearch)
    {
        @Html.Hidden("SubsidiaryListData", Model.SubsidiaryList.ToJson())
    }
</nav>