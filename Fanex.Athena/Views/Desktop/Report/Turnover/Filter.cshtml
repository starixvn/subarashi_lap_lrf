@{
    Layout = null;
    var appSettings = new AppSettings();
}
@model Fanex.Athena.Model.Report.ViewModel.TurnoverViewModel
<div class="page-form">
    @using (Html.BeginForm("Turnover", "Report", FormMethod.Post, new { @id = "TurnoverForm" }))
    {
        @Html.AntiForgeryToken()
        //-----------------------------Hidden Field-------------------------------//

        @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
        @Html.Hidden("IsAllowedCasinoTransfer", Model.IsAllowedCasinoTransfer)
        @Html.Hidden("IsAllowBa", Model.ProductAccess.IsAllowBA)
        <div class="row">
            @DesktopRazorHelper.MonthPicker(Model.Param.FromDate, Model.Param.ToDate)

            <div class="input-field col l2 m3 s12">
                @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @DesktopRazorHelper.BasedCurrency(Model.Param.BaseCurrency)
                <label>@ViewResources.BaseCurrency</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @Html.TextBox("Username", Model.Param.Username, new { placeholder = (Model.IsFakeLicensee ? ViewResources.ExternalId : ViewResources.ExternalIdOrSystemId), autocomplete = "off" })
                <label>@ViewResources.Username</label>
                <ul id="suggestionDropdown" class="dropdown-content ac-dropdown"></ul>
            </div>
        </div>
        <div class="row">
            @DesktopRazorHelper.RenderProductFilter(Model.Param.ProductOptions)

            <div class="input-field input col l2 m3 s12 offset-l1">
                <input type="radio" value="true" class="with-gap" @(Model.Param.IsExcludedTestData == true ? "checked=checked" : "") name="IsExcludedTestData" id="IsExcludedTestData0" />
                <label for="IsExcludedTestData0">
                    @ViewResources.Yes
                </label>
                <input type="radio" class="with-gap" value="false" @(Model.Param.IsExcludedTestData == false ? "checked=checked" : "") name="IsExcludedTestData" id="IsExcludedTestData1" />
                <label for="IsExcludedTestData1">
                    @ViewResources.No
                </label>

                <label class="active">@ViewResources.ExcludeTestData</label>
            </div>

            <div class="col l1 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>

            <div class="col right icon-block">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>
        <div>
            <input type="hidden" id="FromDay" name="FromDay" value="@Model.Param.FromDay" />
            <input type="hidden" id="ToDay" name="ToDay" value="@Model.Param.ToDay" />
            <input type="hidden" id="Month" name="Month" value="@Model.Param.Month" />
            <input type="hidden" id="Year" name="Year" value="@Model.Param.Year" />
            <input type="hidden" id="IsExportExcel" name="IsExportExcel" value="@Model.Param.IsExportExcel" />
            @{
                var beginOfMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                var minDate = beginOfMonth.AddMonths(-18);
            }
            <input type="hidden" id="MinDate" value="@minDate.ToString("yyyy/M/d")" />
            <input type="hidden" id="MaxDate" value="@appSettings.MaxDate.ToString("yyyy/M/d")" />
        </div>
    }
</div>