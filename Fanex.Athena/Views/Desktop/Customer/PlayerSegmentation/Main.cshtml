@{
    ViewBag.Title = "LAP - " + ViewResources.Customer + " - " + ViewResources.PlayerSegmentation;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain
@model Fanex.Athena.Model.Customer.ViewModel.PlayerSegmentationViewModel
@{
    var hasVIPManagementPermission = Model.HasVIPManagementPermission;
    var vipPlayerManagementVM = Model.VipPlayerVM;
    var monitoredPlayerVM = Model.MonitoredPlayerVM;

    string selectedSubsidiary = Model.ViewType == SubsidiaryViewType.MasterManagement ?
        string.Join(",", Model.SubsidiaryList.SelectMany(x => x.Children.Select(y => y.Value)).Distinct()) 
        : string.Join(",", Model.SubsidiaryList.Select(x => x.Value));

    var vipPlayerManagementInitState = hasVIPManagementPermission ? new
    {
        selectedCurrency = string.Join(",", vipPlayerManagementVM.CurrencyList.Select(x => x.Key).ToArray()),
        selectedVipOption = 0,
        selectedSubsidiary,
        username = "",
        isLoading = false,
        playerList = null as object,
        selectedParams = null as object,
        selectedCustomerClass = string.Join(",", vipPlayerManagementVM.RiskLevels.Select(r => string.Join(",", r.CustomerClassList))),
        selectedRiskLevel = string.Join(",", vipPlayerManagementVM.RiskLevels.Select(r => r.Id)),

        dateRange = new
        {
            fromDate = vipPlayerManagementVM.FromReachedDate.ToString("MM/dd/yyyy"),
            toDate = vipPlayerManagementVM.ToReachedDate.ToString("MM/dd/yyyy")
        },
    } : null;

    var vipPlayerManagementData = hasVIPManagementPermission ? new
    {
        currencyList = vipPlayerManagementVM.CurrencyList.Select(x => new { key = x.Key, value = x.Value, status = true }),
        vipOptions = vipPlayerManagementVM.VipOptions.Select(x => new { value = x.Key, label = x.Value }),
        riskLevelList = vipPlayerManagementVM.RiskLevels.Select(r => new
        {
            key = r.Id,
            value = r.Name,
            valueDecoration = "risk-level " + r.Key,
            customerClassList = string.Join(",", r.CustomerClassList),
            status = true
        }),
        dateConstraint = new
        {
            minDate = vipPlayerManagementVM.MinReachedDate.ToString("MM/dd/yyyy"),
            maxDate = vipPlayerManagementVM.MaxReachedDate.ToString("MM/dd/yyyy")
        },
    } : null;

    var monitoredPlayerInitState = monitoredPlayerVM != null ? new
    {
        selectedCurrency = string.Join(",", monitoredPlayerVM.CurrencyList.Select(x => x.Key).ToArray()),
        selectedSubsidiary,
        username = "",
        isLoading = false,
        isGetAll = true,
        playerList = null as object,
        selectedParams = null as object,
        dateRange = new
        {
            fromDate = monitoredPlayerVM.FromReachedDate.ToString("MM/dd/yyyy"),
            toDate = monitoredPlayerVM.ToReachedDate.ToString("MM/dd/yyyy")
        },
        supportedReachedDateRange = new
        {
            fromDate = monitoredPlayerVM.MinReachedDate.ToString("MM/dd/yyyy"),
            toDate = monitoredPlayerVM.MaxReachedDate.ToString("MM/dd/yyyy")
        },
    } : null;

    var monitoredPlayerData = monitoredPlayerVM != null ? new
    {
        canEdit = monitoredPlayerVM.CanEdit,
        currencyList = monitoredPlayerVM.CurrencyList.Select(x => new { key = x.Key, value = x.Value, status = true }),
        dateConstraint = new
        {
            minDate = monitoredPlayerVM.MinReachedDate.ToString("MM/dd/yyyy"),
            maxDate = monitoredPlayerVM.MaxReachedDate.ToString("MM/dd/yyyy")
        },
    } : null;
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/customer/playersegmentation/index.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/customer/playersegmentation/main.chunk.js")"></script>
}
@section globaljscode{
    window.initialState = {
    VipPlayerManagement: @Html.Raw(vipPlayerManagementInitState.ToJson()),
    MonitoredPlayer: @Html.Raw(monitoredPlayerInitState.ToJson()),
    }

    window._AppData = {
    HasVipManagement: @hasVIPManagementPermission.ToString().ToLower(),
    HasVipManagementEdit: @Model.HasVIPManagementEditPermission.ToString().ToLower(),
    TabKeys: @Html.Raw(Model.TabKeys.ToJson()),
    subsidiaryList: @Html.Raw(Model.SubsidiaryList.ToJson()),
    viewType: @((byte)Model.ViewType),
    VipPlayerManagement: @Html.Raw(vipPlayerManagementData.ToJson()),
    MonitoredPlayer: @Html.Raw(monitoredPlayerData.ToJson()),
    isHideSaba: '@Model.IsHideSaba.ToString()' === 'True'
    }
}
<div id="app-container">
</div>