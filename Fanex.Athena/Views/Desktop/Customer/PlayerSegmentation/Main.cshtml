@{
    ViewBag.Title = "LAP - " + ViewResources.Customer +
    " - " + "Player Segmentation";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@model Fanex.Athena.Model.Customer.ViewModel.PlayerSegmentationViewModel
@{
    var problemPlayerVM = Model.ProblemPlayerVM;
    var vipPlayerManagementVM = Model.VipPlayerVM;
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/playersegmentation/index.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/playersegmentation/main.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
        ProblemPlayer: {
            dateRange: { fromDate: '@problemPlayerVM.FromDate.ToString("MM/dd/yyyy")', toDate: '@problemPlayerVM.ToDate.ToString("MM/dd/yyyy")'},
            selectedCurrency: '@string.Join(",", problemPlayerVM.CurrencyList.Select(x => x.Key).ToArray())',
            username: '',
            isLoading: false,
            playerList: null,
            selectedParams: null,
            isGetAll: true
        },
        VipPlayerManagement: {
            selectedCurrency: '@string.Join(",", vipPlayerManagementVM.CurrencyList.Select(x => x.Key).ToArray())',
            selectedVipOption: 0,
            username: '',
            isLoading: false,
            playerList: null,
            selectedParams: null,
            isGetAll: true
        }
    }

    window._AppData = {
        ProblemPlayer: {
            currencyList: @Html.Raw(problemPlayerVM.CurrencyList.Select(x => new { key = x.Key, value = x.Value, status = true }).ToJson()),
            dateConstraint: { minDate: '1/1/2017', maxDate: '@problemPlayerVM.MaxDate.ToString("MM/dd/yyyy")', limitedMonthRange: 1 },
        },
        VipPlayerManagement: {
            currencyList: @Html.Raw(vipPlayerManagementVM.CurrencyList.Select(x => new { key = x.Key, value = x.Value, status = true }).ToJson()),
            vipOptions: @Html.Raw(vipPlayerManagementVM.VipOptions.Select(x => new { value = x.Key, label = x.Value }).ToJson()),
        }
    }
}

    <div id="app-container">
    </div>