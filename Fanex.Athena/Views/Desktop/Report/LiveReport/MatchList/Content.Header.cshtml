@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportMatchListViewModel

@{
    var rowspanText = Model.IsAllowedCustomerCommission ? "rowspan=2" : "";
    var colspanText = Model.IsAllowedCustomerCommission ? "colspan=3" : "";
}

<tr>
    <th @rowspanText>
        @ViewResources.Match
    </th>
    <th @colspanText>
        @ViewResources.CustomerW_L
    </th>
    <th class="sortable" @rowspanText>
        <a class="sort-heading" data-column-name="TurnOver">@ViewResources.Turnover</a>
    </th>
    <th class="sortable header-small" @rowspanText>
        <a class="sort-heading" data-column-name="BetCount">@ViewResources.BetCount</a>
    </th>
    <th class="sortable" @rowspanText>
        <a class="sort-heading" data-column-name="LicenseeWinLoss">@ViewResources.LicenseeW_L</a>
    </th>
    @if (Model.ProductAccess.IsAllowBA)
    {
        <th class="sortable header-small" @rowspanText>
            <a class="sort-heading" data-column-name="LicenseeComm">@ViewResources.Comm</a>
        </th>
    }
    @if (Model.HasAmountDueToColumn)
    {
        <th class="sortable header-small" @rowspanText>
            <a class="sort-heading" data-column-name="AmountDue">@ViewResources.AmountDueTo</a>
        </th>
    }
</tr>

@if (Model.IsAllowedCustomerCommission)
{
    <tr>
        <th class="sortable">
            <a class="sort-heading" data-column-name="CustomerWinLoss">@ViewResources.WinLoss</a>
        </th>
        <th class="sortable">
            <a class="sort-heading" data-column-name="CustomerComm">@ViewResources.Comm</a>
        </th>
        <th class="sortable">
            <a class="sort-heading" data-column-name="CustomerTotal">@ViewResources.Total</a>
        </th>
    </tr>
}