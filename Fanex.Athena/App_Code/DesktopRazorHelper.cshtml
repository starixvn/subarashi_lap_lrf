    }

    title = SystemConstants.BaseCurrencyList.ContainsKey(currencyId) ?
        string.Format(ViewResources.Viewin, SystemConstants.BaseCurrencyList[currencyId]) :
        string.Format(ViewResources.Viewin, currencyName);

    @(title)
}

