@using Fanex.Athena.Model.Core.DataDomain
@model Fanex.Athena.Model.Report.ViewModel.LicenseeWinLossViewModel
<div class="page-form">
    <form id="licenseewinloss" name="licenseewinloss" method="post" action="">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="input-field input col l3 m3 s12 calendar date-range">
                @DesktopRazorHelper.DateRangePicker(Model.Param.FromDate, Model.Param.ToDate, Model.ReportSetting.MinDate, Model.ReportSetting.MaxDate)
            </div>

            <div class="input-field col l2 m3 s12">
                @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId, true, true)
                <label>@ViewResources.Currency</label>
            </div>

            @DesktopRazorHelper.RenderProductFilter(Model.Param.ProductOptions)

            <div class="col right right-filter-menu">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
                <a class="right" href="javascript:;" id="ExportPromotionPrizeLink" style="display: none;">@ViewResources.PromotionPrize</a>
            </div>
        </div>

        <div class="row">
            <div class="input-field input col l3 m4 s12">
                <input type="radio" value="1" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.Normal ? "checked=checked" : "") name="DrawFilter" id="DrawFilter" />
                <label for="DrawFilter">
                    @ViewResources.Normal
                </label>
                <input type="radio" value="2" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.NoDraws ? "checked=checked" : "") name="DrawFilter" id="DrawFilterNoDraw" />
                <label for="DrawFilterNoDraw">
                    @ViewResources.NoDraws
                </label>
                <input type="radio" value="3" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.NoDrawsForTurnoverOnly ? "checked=checked" : "") name="DrawFilter" id="DrawFilterNoDrawsForTurnoverOnly" />
                <label for="DrawFilterNoDrawsForTurnoverOnly">
                    @ViewResources.NoDrawsForTurnoverOnly
                </label>

                <label class="active">@ViewResources.DrawFilter</label>
            </div>

            <div class="input-field input col l2 m3 s12">
                <input type="radio" class="with-gap" value="1" @(Model.Param.ReportBy == ReportByType.Daily ? "checked=checked" : "") name="ReportBy" id="reportbydaily" />
                <label for="reportbydaily">
                    @ViewResources.Daily
                </label>
                <input type="radio" class="with-gap" value="2" @(Model.Param.ReportBy == ReportByType.Monthly ? "checked=checked" : "") name="ReportBy" id="reportbymonthly" />
                <label for="reportbymonthly">
                    @ViewResources.Monthly
                </label>

                <label class="active">@ViewResources.ReportBy</label>
            </div>

            <div class="input-field input col l2 m3 s12">
                <input type="radio" value="true" class="with-gap" @(Model.Param.IsExcludedTestData == true ? "checked=checked" : "") name="IsExcludedTestData" id="IsExcludedTestData0" />
                <label for="IsExcludedTestData0">
                    @ViewResources.Yes
                </label>
                <input type="radio" class="with-gap" value="false" @(Model.Param.IsExcludedTestData == false ? "checked=checked" : "") name="IsExcludedTestData" id="IsExcludedTestData1" />
                <label for="IsExcludedTestData1">
                    @ViewResources.No
                </label>

                <label class="active">@ViewResources.ExcludeTestData</label>
            </div>

            <div class="col l2 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>
        </div>

        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>

    @Html.Hidden("ProductOptionJson", Model.Param.ProductOptions.ToJson())
    @Html.Hidden("drillDownLicenseeId", Model.Param.LicenseeId)
    @Html.Hidden("IsAllowedBACommission", Model.ProductAccess.IsAllowBA)
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
</div>
