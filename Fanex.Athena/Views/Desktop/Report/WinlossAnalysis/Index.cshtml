@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + "Win Loss Analysis";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain
@using Fanex.Athena.Service.Core.Users.Interfaces
@using Fanex.Athena.Service.Core.Common.Interfaces
@model Fanex.Athena.Model.Report.ViewModel.WinlossAnalysisReportViewModel
@{
    var appSettings = DependencyResolver.Current.GetService<IAppSettings>();
    var session = DependencyResolver.Current.GetService<ISessionService>();
    var currencyService = DependencyResolver.Current.GetService<ICurrencyService>();
    var betTicketEventBuilderUrl = appSettings.BetTicketEventBuilderUrl;
    var selectedProduct = string.Join(",", Model.ProductOptionList.Select(p => p.Code));

    var selectedStatus = string.Join(",", Model.StatusList.Where(x => x.Checked).Select(x => x.ID).ToArray());
    var selectedLiveStatus = string.Join(",", Model.LiveStatusList.Select(x => x.Key).ToArray());
    var selectedPlatform = string.Join(",", Model.PlatformList.Select(x => x.Key).ToArray());
    var baseCurrencyList = currencyService.GetBaseCurrencyList(true).Select(c => new { value = c.Value, label = c.Value }).ToList();
    var selectedCurrency = string.Join(",", Model.CurrencyList.Select(x => x.Key).ToArray());

    var whitelabelList = Model.SubsidiaryList;
    var subsidiaryList = Model.SubsidiaryList.SelectMany(x => x.Children.Select(y => y.Value)).Distinct();
    var selectedSubsidiary = string.Join(",", subsidiaryList);
    var vipOnlyList = SystemConstants.VipOnyList
        .Select(c => new { value = c.Key, label = c.Value }).ToList();

    var selectedCustomerClass = string.Join(",", Model.RiskLevels.Select(r => string.Join(",", r.CustomerClassList)));
    var selectedRiskLevel = string.Join(",", Model.RiskLevels.Select(r => r.Id));
    var riskLevelList = Model.RiskLevels.Select(r => new
    {
        id = r.Id,
        value = r.Name,
        valueDecoration = "risk-level " + r.Key,
        customerClassList = string.Join(",", r.CustomerClassList),
        status = true
    });

    var selectedOddsGroup = string.Join(",", Model.OddGroups);
    var oddsGroupList = Model.OddGroups.Select(c => new
    {
        id = c,
        value = c,
        status = true
    });
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/winlossanalysis/index.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/betlist/index.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/bettingticketscenter/index.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/winlossanalysis.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    dateRange: { fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")'},
    selectedProduct: '@(selectedProduct)',
    selectedCurrency:  '@(selectedCurrency)',
    selectedBaseCurrency: '@(Model.SelectedBaseCurrency)',
    isLoading: false,
    selectedStatus: '@(selectedStatus)',
    selectedLiveStatus: '@(selectedLiveStatus)',
    selectedSubsidiary: '@(selectedSubsidiary)',
    selectedPlatform: '@(selectedPlatform)',
    sportList: [],
    selectedSport: 0,
    selectedVipOnly: 0,
    selectedGroupByOption: 8,
    selectedBreakDownByOption: 2,
    selectedCustomerClass: '@(selectedCustomerClass)',
    selectedOddsGroup: '@(selectedOddsGroup)',
    bettypeList: [],
    selectedBettype: 0,
    username: '',
    isGroupInOriginalCurrency: true,
    isExcludeTestData: true,
    isViewCashOutOnly: false,
    };
    window._AppData = {
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    subsidiaryViewType: @Model.SubsidiaryViewType,
    isOneworksMaster: '@Model.IsOneworksMaster' === 'True',
    whitelabelList: @Html.Raw(whitelabelList.ToJson()),
    subsidiaryList: @Html.Raw(subsidiaryList.ToJson()),
    vipOnlyList: @Html.Raw(vipOnlyList.ToJson()),
    liveStatusList: @Html.Raw(Model.LiveStatusList.Select(x => new { id = x.Key, value = x.Value, status = true }).ToJson()),
    statusList: @Html.Raw(Model.StatusList.Select(x => new { id = x.ID, value = x.Name, status = x.Checked }).ToJson()),
    isAllowedCustomerComm: @Model.IsAllowedCustomerComm.ToJson(),
    productList: @Html.Raw(Model.ProductOptionList.Select(x => new { id = x.Code, value = x.Name, status = true }).ToJson()),
    currencyList: @Html.Raw(Model.CurrencyList.Select(x => new { id = x.Key, value = x.Value, status = true }).ToJson()),
    platformList: @Html.Raw(Model.PlatformList.Select(x => new { id = x.Key, value = x.Value, status = true }).ToJson()),
    riskLevelList: @Html.Raw(riskLevelList.ToJson()),
    oddsGroupList: @Html.Raw(oddsGroupList.ToJson()),
    dateConstraint: { minDate: '@Model.MinDate.ToString("MM/dd/yyyy")', maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")', limitedMonthRange: 3 },
    licenseeName: '@session.LicenseeSession.LicenseeName',
    isOfferCashOutProduct: '@Model.IsOfferCashOutProduct' === "True",
    isHasPermissionViewVip: '@Model.IsHasPermissionViewVip' === "True"
    };
}
<div id="app-container">
</div>