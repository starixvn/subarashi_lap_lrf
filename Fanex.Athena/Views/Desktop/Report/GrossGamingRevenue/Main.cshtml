@{
    ViewBag.Title = "LAP - " + ViewResources.GrossGamingRevenue;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Athena.Model.Report.ViewModel.GrossGamingRevenueViewModel
@using Fanex.Athena.Model.Core.DataDomain
@{

    var currencyList = (new[]
    {
        new { value = BaseCurrencyType.All, label = ViewResources.All, baseCurrency = string.Empty }
    })
    .Union(Model.BaseCurrencyList.Select(x => new { value = x.Key, label = ViewResources.Based + " " + x.Value, baseCurrency = x.Value }))
    .Union(Model.CurrencyList.Select(x => new { value = x.Key, label = x.Value, baseCurrency = string.Empty }));

    var productOptions = Model.Param.ProductOptions;
    var selectedProductCode = string.Join(",", productOptions.Where(x => x.Status).Select(x => x.Code).ToArray());

    var reportByList = new List<dynamic>
    {
        new { value = ReportByType.Daily.ToString(), label = ViewResources.Daily },
        new { value = ReportByType.Weekly.ToString(), label = ViewResources.Weekly },
        new { value = ReportByType.Monthly.ToString(), label = ViewResources.Monthly }
    };
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/grossgamingrevenue/index.css")" rel="stylesheet" type="text/css" />
}

@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/grossgamingrevenue.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    dateRange: {fromDate: '@Model.Param.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.Param.ToDate.ToString("MM/dd/yyyy")'},
    selectedCurrency: @Html.Raw(currencyList.FirstOrDefault(x => x.value == Model.Param.CurrencyId).ToJson()),
    selectedProduct: '@(selectedProductCode)',
    reportByList: @Html.Raw(reportByList.ToJson()),
    selectedReportBy: '@(Model.Param.ReportBy)',
    xsrfToken: document.querySelector("input[name=__RequestVerificationToken]").value,
    isLoading: false
    };

    window._AppData = {
    currencyList: @Html.Raw(currencyList.ToJson()),
    productOptions: @Html.Raw(productOptions.ToJson()),
    dateConstraint: {minDate: '@Model.ReportSetting.MinDate.ToString("MM/dd/yyyy")', maxDate: '@Model.ReportSetting.MaxDate.ToString("MM/dd/yyyy")', limitedMonthRange: 1},
    viewMode: @Html.Raw(Model.ViewMode)
    };
}
<div id="app-container">
</div>