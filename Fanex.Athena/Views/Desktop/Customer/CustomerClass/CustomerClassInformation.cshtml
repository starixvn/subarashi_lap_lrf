@using Fanex.Athena.Model.Customer.DTO
@using Fanex.Athena.Model.Customer.Enum

@model IEnumerable<CustomerClassModel>
@{
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
    var classNameTab = ViewBag.TabKey == (byte)CustomerClassTabType.SettingPolicy ? "customer-class-policy-setting" : "customer-class-spread-setting";
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/customer/customer-class.css")" rel="stylesheet" />
}
@section Content{
    <div class="page-results @classNameTab">
        <div class="tab">
            <ul>
                <li>
                    <a class="policy-setting" href="~/CustomerClass/CustomerClassInformation?tabKey=1">@ViewResources.CustomerClassSettingPolicy</a>
                </li>
                <li>
                    <a  class="spread-setting" href="~/CustomerClass/CustomerClassInformation?tabKey=2">@ViewResources.CustomerClassSpreadSettingPolicy</a>
                </li>
            </ul>
        </div>
        <div class="result-content">
            <div class="main-content">
                @if (ViewBag.TabKey == (byte)CustomerClassTabType.SettingPolicy)
                {
                    Html.RenderPartial("~/Views/Desktop/Customer/CustomerClass/SettingPolicyTab.cshtml", Model);
                }
                else
                {
                    Html.RenderPartial("~/Views/Desktop/Customer/CustomerClass/SpreadSettingPolicyTab.cshtml", Model);
                }
            </div>
        </div>
    </div>
}
