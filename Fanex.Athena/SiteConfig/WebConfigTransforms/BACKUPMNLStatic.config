<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <configSections xdt:Transform="Replace">

  </configSections>
  <log4net xdt:Transform="Remove" >

  </log4net>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider" xdt:Transform="Remove"  />
  <Fanex.Logging xdt:Transform="Remove"  />

  <system.web>
    <compilation debug="false" targetFramework="4.6.1" xdt:Transform="Replace" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
    <authentication mode="None" xdt:Transform="Replace">
    </authentication>
    <sessionState mode="Off" cookieName="__lap_b_report_s" stateConnectionString="tcpip=10.2.98.3:42424" timeout="25" xdt:Transform="Replace" />

  </system.web>
  <system.net xdt:Transform="Insert">
    <defaultProxy useDefaultCredentials="true"> </defaultProxy>
  </system.net>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false" xdt:Transform="Replace">
      <remove name="FormsAuthentication" />
    </modules>
    <httpProtocol xdt:Transform="Replace">
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <ONEbook.UM ServiceUris="http://10.40.40.202:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="01:00" UMTo="23:00" SiteId="2000001" UMPageUrl="~/Utility/UnderMaintenance" xdt:Transform="Remove">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
  <location path="www" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="img" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Resources" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Integrate" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="DBConnectionData" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Form" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Logs" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Views" xdt:Transform="Insert">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="SiteConfig" xdt:Transform="Insert">
