
@using Fanex.Athena.Model.Customer.DTO
@model IEnumerable<CustomerClassModel>

@if (Model.Count() == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <table id="customer-class-info-spread-setting" class="table table-bordered">
        <thead>
            <tr>
                <th class="col-small">@ViewResources.CustomerClass</th>
                <th class="col-child">@ViewResources.Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="center-align">@m.Id</td>
                    <td class="center-align">@m.Category</td>
                </tr>
            }
        </tbody>
    </table>
}