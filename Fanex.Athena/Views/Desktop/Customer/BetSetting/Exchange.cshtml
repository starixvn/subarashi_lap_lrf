@model Fanex.Athena.Model.BetSettings.ViewModel.ExchangeBetSettingViewModel
@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/exchangebetsetting.chunk.js")"></script>
}
@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/_Menu.cshtml", Model);}
}
@section ContentTitle{
    @Model.Title
}
<!--Content-->
@if (Model.IsNoInfo)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div style="padding: 20px 0; width: 300px">
        <label>@ViewResources.ChargeCommission</label>
        <div>
            @if (Model.IsEnabled == true)
            {
                <select data-original-value="@Model.Commission" id="ddlCommission" class="select">
                    @foreach (var value in Model.CommissionList)
                    {
                        <option value="@value" @(value == Model.Commission ? "selected" : null)>@(value)%</option>
                    }
                </select>
            }
            else
            {
                <div style="width: 300px;border-bottom: 1px solid #ddd;color: #aaa">@(Model.Commission)%</div>
            }
        </div>
    </div>
}
<!--/Content-->
<!--SubmitButton-->
@if (Model.Editable && Model.IsEnabled.HasValue)
{
    var disabledText = Model.IsEnabled == true ? null : "disabled";
    <div class="right button-block">
        @if (!Model.IsNoInfo)
        {
            <button @disabledText type="button" class="btn btn-submit" data-cust-id="@Model.Param.CustId" id="btnSubmit">
                @ViewResources.Submit
            </button>
            <button @disabledText type="button" class="btn btn-cancel" id="btnReset">
                @ViewResources.Reset
            </button>
        }
        <button type="button" class="btn btn-submit"
                data-status="@(Model.IsEnabled.Value ? 0 : 1)"
                data-cust-id="@Model.Param.CustId"
                data-nick-name="@Model.Param.NickName"
                id="btnUpdateStatus">
            @(string.Format(Model.IsEnabled.Value ? ViewResources.DisableProduct : ViewResources.EnableProduct, ViewResources.ProductBX))
        </button>
    </div>
}
<!--/SubmitButton-->
