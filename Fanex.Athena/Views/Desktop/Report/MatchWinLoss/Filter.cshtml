@model Fanex.Athena.Model.Report.ViewModel.MatchWinLossViewModel
@{
    var maxDate = DateTime.Today.AddDays(1);
    var threeYearsAgo = DateTime.Today.AddYears(-3);
    var minDateSupportData = new DateTime(2021, 6, 1);
    var minDate = threeYearsAgo < minDateSupportData ? minDateSupportData : threeYearsAgo;
}
<div class="page-form">
    @using (Html.BeginForm("Index", "MatchWinLossReport", FormMethod.Post, new { @id = "MatchWinLossForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            @*// ----------------------------Date---------------------------//*@
            <div class="col l2 m3 s12 input-field calendar single-date">
                @DesktopRazorHelper.SingleDatePicker(Model.Param.Date, minDate, maxDate, "Date")
            </div>

            @*// -----------------------------Currency-----------------------------------//*@
            <div class="col l2 m2 s12 input-field">
                @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId)
                <label>@ViewResources.Currency</label>
            </div>

            @*// -----------------------------Base Currency-----------------------------------//*@
            <div class="col l2 m1 s12 input-field">
                @DesktopRazorHelper.BasedCurrency(Model.Param.BaseCurrency)
                <label>@ViewResources.BaseCurrency</label>
            </div>

            @*// -----------------------------Product Check List-----------------------------------//*@
            @DesktopRazorHelper.RenderProductFilter(Model.Param.ProductOptions, 2, 3)

            <div class="col l1 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>

            <div class="col right icon-block">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>

        @Html.Hidden("BalanceUpDay", Model.Param.BalanceUpDay)
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        @Html.Hidden("SubsidiarySearch", false)
        @Html.Hidden("SubsidiaryList", string.Empty)
    }
</div>