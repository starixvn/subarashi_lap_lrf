@using Fanex.Athena.Model.Customer.DTO.PlayerSegmentation
@model IEnumerable<CustomerClassModel>
@{
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
    var currency = "MYR";
}
@section Content{
    <div class="page-results">
        <div class="result-content">
            <div class="main-content">
                @if (Model.Count() == 0)
                {
                    <p class="no-info-row">@ViewResources.NoInfo</p>
                }
                else
                {
                    <table id="customer-class-info" class="table table-bordered">
                        <thead>
                            <tr>
                                <th class="col-small">#</th>
                                <th class="col-medium">@ViewResources.CustomerClass</th>
                                <th class="col-medium">@ViewResources.Live2/<br />@ViewResources.PreMatch</th>
                                <th class="col-large">@ViewResources.SportType</th>
                                <th class="col-medium">@ViewResources.LeagueGroupId</th>
                                <th class="col-medium">@ViewResources.BetInterval</th>
                                <th class="col-medium">@ViewResources.MaxPerBet (@currency)</th>
                                <th class="col-medium">@ViewResources.MaxPerMatch2 (@currency)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int number = 1;
                                foreach (var m in Model)
                                {
                                    <tr>
                                        <td class="center-align">@(number++)</td>
                                        <td class="center-align">@m.CustomerClass</td>
                                        <td class="left-align">@(m.LiveType == 1 ? ViewResources.Live2 : ViewResources.PreMatch)</td>
                                        <td class="left-align">@m.SportTypeName</td>
                                        <td class="right-align">@m.LeagueGroupId</td>
                                        <td class="right-align">@m.BetInterval</td>
                                        <td class="right-align">@m.MaxBet</td>
                                        <td class="right-align">@m.MaxPerMatch</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}
