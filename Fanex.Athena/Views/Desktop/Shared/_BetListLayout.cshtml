@{
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Service.Core.Users.Interfaces;
@{
    var appSettings = DependencyResolver.Current.GetService<IAppSettings>();
    var betTicketEventBuilderUrl = appSettings.BetTicketEventBuilderUrl;
}
@section css
{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/betlistLayout.css")" rel="stylesheet" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/lib/jqgrid.chunk.js")"></script>
    <script async src="@betTicketEventBuilderUrl" id="event-builder-script"></script>
    @RenderSection("pagejs", required: false)
}

<div class="report-container betlist-container">
    @if (IsSectionDefined("ContentTitle"))
    {
        <div class="page-tab">
            @RenderSection("ContentTitle", required: false)
        </div>
    }
    <div class="page-form">
        @RenderSection("ContentFilter", required: false)
    </div>
    <div class="page-results">
        <div id="report-container">
            <div class="theme_jqGrid">
                <div id="pager1">
                </div>
                <table id="BetListGrid"></table>
                <div id="pager2">
                </div>
            </div>
            @RenderBody()
        </div>
    </div>
</div>