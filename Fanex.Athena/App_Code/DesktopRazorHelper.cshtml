@helper RenderProductFilter(IEnumerable<ProductOption> productOptions, int colLg = 3, int colMd = 4)
{
    /**/

    // initial script in: components/pluginhelper/multiselect.js
    var Url = new UrlHelper(Context.Request.RequestContext);
    var i = 0;
    <div class="input-field col l@(colLg) m@(colMd) s12">
        <div class="multiselect-container" id="ProductList">
            <select id="grid-products-multiselect" name="grid-products-multiselect"></select>
            <label>@ViewResources.Product *</label>

            <div class="hide" id="product-container">
                @foreach (var product in productOptions)
                {
                    <input type="hidden" name="ProductOptions[@i].Code" value="@product.Code" />
                    <input type="hidden" name="ProductOptions[@i].Name" value="@product.Name" />
                    <input type="checkbox" class="childCheckbox" data-original="@product.Status.ToString().ToLower()" id="@product.Code" data-product-code="@product.Code" @(product.Status ? "checked" : "") name="ProductOptions[@i].Status" value="true" />
                    i++;
                }
            </div>
            <input type="hidden" id="productsData" value="@productOptions.ToJson()" />
        </div>
    </div>
}

