@{
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@section css
{
    <link href="~/Content/Plugin/MultiSelect/jquery.multiselect.css" rel="stylesheet" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/customer/betsetting.css")" rel="stylesheet" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    @RenderSection("pagejs", required: false)
}
<div class="page-results">
    <div id="formContent" class="betsetting-container">
        @RenderSection("Menu", required: false)
        <div class="row">
            <p class="content-title">
                @RenderSection("ContentTitle", required: false)
            </p>
        </div>
        <div class="row setting-content">
            @RenderBody()
        </div>
    </div>
</div>
