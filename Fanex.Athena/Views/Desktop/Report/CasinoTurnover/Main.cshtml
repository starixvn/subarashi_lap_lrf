@{
    ViewBag.Title = "LAP - " + ViewResources.Report +
    " - " + ViewResources.CasinoTurnover;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Athena.Model.Report.ViewModel.CasinoTurnoverViewModel
@{
    var selectedProductCode = string.Join(",", Model.ProductOptions.Where(x => x.Status).Select(x => x.Code));

    var baseCurrencyList = Model.BaseCurrencies.Select(c => new { value = c, label = c }).ToList();

    var currencyList = Model.CurrencyList.Select(x => new { value = x.Key, label = x.Value }).ToList();
    currencyList.Insert(0, new
    {
        value = 0,
        label = ViewResources.All
    });

    var statusList = Model.Status.Select(x => new { Code = x.ID, Name = x.Name, Status = x.Checked }).ToList();
    var selectedStatus = string.Join(",", Model.Status.Where(x => x.Checked).Select(x => x.ID));
}

@section pagecss {

    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/casinoturnover/index.css")" rel="stylesheet" type="text/css" />

}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/casinoturnover.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    dateRange: {fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")'},
    selectedCurrency: @Html.Raw(currencyList.First().ToJson()),
    selectedBaseCurrency: '@ViewBag.DefaultSelectedBaseCurrency',
    isConvertAll: true,
    selectedProduct: '@(selectedProductCode)',
    username: '',
    selectedStatus: '@(selectedStatus)',
    isLoading: false
    }

    window._AppData = {
    dateConstraint: {minDate: '@Model.MinDate.ToString("MM/dd/yyyy")', maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")'},
    currencyList: @Html.Raw(currencyList.ToJson()),
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    productOptions: @Html.Raw(Model.ProductOptions.ToJson()),
    statusList: @Html.Raw(statusList.ToJson())
    };
}
<div id="app-container">

</div>
