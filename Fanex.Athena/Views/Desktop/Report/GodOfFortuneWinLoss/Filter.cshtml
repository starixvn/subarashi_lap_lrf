@using Fanex.Athena.Model.Core.DataDomain
@using Fanex.Athena.Service.Core.Users.Interfaces
@model Fanex.Athena.Model.Report.ViewModel.GodOfFortuneWinLossViewModel
@{
    var appSettings = DependencyResolver.Current.GetService<IAppSettings>();
    var session = DependencyResolver.Current.GetService<ISessionService>();
    bool isOfferCryptoCurrencyLicensee = appSettings.OfferCryptoCurrencyLicensees.Split(',').Contains(session.LicenseeSession.LicenseeName, StringComparer.InvariantCultureIgnoreCase);
    var offerCurrencyIds = isOfferCryptoCurrencyLicensee ? SystemConstants.BaseCryptoCurrencyListIds : SystemConstants.BaseCurrencyListIds;
    
    var currencyOptions = this.Model.CurrencyList
        .Select(item => new { Code = item.Key.ToString(), Name = item.Value, Status = true }).ToList();
    var i = 0;

    var baseCurrencyList = SystemConstants.BaseCurrencyList.Where(_ => offerCurrencyIds.Contains(_.Key))
           .Select(item => new SelectListItem
           {
               Value = item.Value.ToLowerInvariant(),
               Text = item.Value,
               Selected = String.Equals(item.Value, this.Model.Param.BaseCurrency,
                   StringComparison.OrdinalIgnoreCase)
           })
           .ToList();
}

<div class="page-form">
    <form id="godoffortunewinloss" name="godoffortunewinloss" method="post" action="">
        @Html.AntiForgeryToken()
        <div class="row">

            <div class="input-field input col l3 m3 s12 calendar date-range">
                @DesktopRazorHelper.DateRangePicker(Model.Param.FromDate, Model.Param.ToDate, Model.ReportSetting.MinDate, Model.ReportSetting.MaxDate)
            </div>

            <div class="input-field col l2 m2 s12">
                <div class="multiselect-container" id="CurrencyList">
                    <select id="grid-currency-multiselect" name="grid-currency-multiselect"></select>
                    <label>@ViewResources.Currency</label>
                    <div class="hide" id="currency-container">
                        @foreach (var currency in currencyOptions)
                        {
                            <input type="hidden" name="CurrencyOptions[@i].Code" value="@currency.Code" />
                            <input type="hidden" name="CurrencyOptions[@i].Name" value="@currency.Name" />
                            <input type="checkbox" class="childCheckbox" data-original="@currency.Status.ToString().ToLower()" id="@currency.Code" data-currency-code="@currency.Code" @(currency.Status ? "checked" : "") name="CurrencyOptions[@i].Status" value="true" />
                            i++;
                        }
                    </div>
                    <input type="hidden" id="currencyData" value="@currencyOptions.ToJson()" />
                </div>
            </div>

            <div class="input-field col l2 m3 s12">
                @Html.DropDownList("BaseCurrency", baseCurrencyList, new { @class = "select" })
                <label>@ViewResources.BaseCurrency</label>
                <input type="hidden" id="baseCurrencyData" value="@baseCurrencyList.Select(_=>new {_.Value, _.Text }).ToJson()" />
                <input type="hidden" id="oldBaseCurrency" value="@this.Model.Param.BaseCurrency" />
            </div>

            <div class="input-field input col l2 m3 s12">
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" class="checkbox" id="IsConvertAll" name="IsConvertAll" @(Model.Param.IsConvertAll == true ? "checked=checked" : "")>
                        <label for="IsConvertAll" class="active">@ViewResources.ConvertAllFiguresToBaseCurrency</label>
                    </div>
                </div>
            </div>

            <div class="col right right-filter-menu">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>

        <div class="row">
            <div class="input-field input col l3 m4 s12">
                <input type="radio" value="1" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.Normal ? "checked=checked" : "") name="DrawFilter" id="DrawFilter" />
                <label for="DrawFilter">
                    @ViewResources.Normal
                </label>
                <input type="radio" value="2" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.NoDraws ? "checked=checked" : "") name="DrawFilter" id="DrawFilterNoDraw" />
                <label for="DrawFilterNoDraw">
                    @ViewResources.NoDraws
                </label>
                <input type="radio" value="3" class="with-gap" @(Model.Param.DrawFilter == DrawFilterType.NoDrawsForTurnoverOnly ? "checked=checked" : "") name="DrawFilter" id="DrawFilterNoDrawsForTurnoverOnly" />
                <label for="DrawFilterNoDrawsForTurnoverOnly">
                    @ViewResources.NoDrawsForTurnoverOnly
                </label>

                <label class="active">@ViewResources.DrawFilter</label>
            </div>

            <div class="input-field input col l2 m3 s12">
                <input type="radio" class="with-gap" value="1" @(Model.Param.ReportBy == ReportByType.Daily ? "checked=checked" : "") name="ReportBy" id="reportbydaily" />
                <label for="reportbydaily">
                    @ViewResources.Daily
                </label>
                <input type="radio" class="with-gap" value="2" @(Model.Param.ReportBy == ReportByType.Monthly ? "checked=checked" : "") name="ReportBy" id="reportbymonthly" />
                <label for="reportbymonthly">
                    @ViewResources.Monthly
                </label>

                <label class="active">@ViewResources.ReportBy</label>
            </div>

            <div class="input-field input col l2 m3 s12">
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" class="checkbox" id="IsExcludedTestData" name="IsExcludedTestData" @(Model.Param.IsExcludedTestData == true ? "checked=checked" : "")>
                        <label for="IsExcludedTestData" class="active">@ViewResources.ExcludeTestData</label>
                    </div>
                </div>
            </div>

            <div class="col l2 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>
        </div>

        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>

    @Html.Hidden("drillDownLicenseeId", Model.Param.LicenseeId)
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
</div>