@using Fanex.Athena.Service.Core.Users.Interfaces;
@{
    Layout = null;
}
@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
}
<div class="header-tab">
    <ul class="tabs">
        <!--Login log tab-->
        <li class="tab">
            <a href="@Url.Action("LogInLog", "CustomerLog")" id="loginlogTab">
                @ViewResources.General
            </a>
        </li>
        <!--/Login log tab-->
        <!--Customer setting log-->
        <li class="tab">
            <a href="@Url.Action("CustomerSetting", "CustomerLog")" id="customersettinglogTab">
                @ViewResources.CustomerSetting
            </a>
        </li>
        <!--/Customer setting log-->
    </ul>
</div>
