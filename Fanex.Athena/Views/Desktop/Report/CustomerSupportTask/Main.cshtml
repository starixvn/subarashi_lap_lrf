@{
    ViewBag.Title = "LAP - " + ViewResources.Report + " - " + ViewResources.CustomerSupportTask;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model IDictionary<int, string>
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/customersupporttask/index.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/customersupporttask.chunk.js")"></script>
}
@section globaljscode{
    window.initialState = {
    selectedCurrency: '@string.Join(",", Model.Select(x => x.Key).ToArray())'
    }

    window._AppData = {
    currencyList: @Html.Raw(Model.Select(x => new { key = x.Key, value = x.Value, status = true }).ToJson()),
    }
}
<div id="app-container">
</div>