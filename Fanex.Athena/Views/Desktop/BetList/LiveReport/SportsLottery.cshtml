@{
    ViewBag.Title = string.Format("LAP - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}

@model Fanex.Athena.Model.BetList.MetaModel.LiveReportBetListMetaModel
@section pagecss {}
@section pagejs {
}
@section ContentTitle
{
    @ViewResources.BetList - @ViewBag.SportName - @Model.FromDate.ToShortDateString()<span class="header-title-arrow">
        →
    </span>@Model.ToDate.ToShortDateString() - <span class="base-currency">@DesktopRazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>

}
@section BackButton
{
    <a href="javascript:window.history.back();" class="icon-back"></a>
}
@{
    <input type="hidden" id="ApiUrl" value="api/LiveReportBetList/SportsLottery" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
    <input type="hidden" id="IsServerPaging" value="1" />
}